<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>🟢 SJ88 Green Screen — ตัดจอเขียว • ออโต้ซูม • แบทช์</title>
<style>
  /* ============================================================
     SJ88 Green Screen — WebApp
     1:1 port of Tk ui/theme.py (dark mode default)
     Tokens copied verbatim from ui/theme.py for visual parity
     ============================================================ */
  :root {
    /* Backgrounds (ui/theme.py: COLOR_BG_*) */
    --bg-canvas:   #0f0f1a;
    --bg-surface:  #16161f;
    --bg-card:     #1f1f2e;
    --bg-raised:   #28283a;
    --bg-hover:    #34344a;
    /* Borders */
    --border:        #2a2a3e;
    --border-focus:  #5a5a72;
    --border-danger: #7a2a2a;
    /* Text */
    --text-primary:   #e8e8f0;
    --text-secondary: #a8a8b8;
    --text-muted:     #6e6e82;
    --text-disabled:  #4a4a60;
    /* TC accents (ui/theme.py: TC_ACCENT) */
    --tc01: #4CAF50;
    --tc02: #A855F7;
    --tc03: #3B82F6;
    --tc04: #06B6D4;
    --tc05: #F59E0B;
    --tc06: #EC4899;
    /* Status */
    --danger:  #EF4444;
    --warning: #F59E0B;
    --success: #10B981;
    /* P29 — design tokens for log levels + button states */
    --log-info:    #a8a8b8;  /* matches --text-secondary */
    --log-ok:      #4ade80;  /* green-400 */
    --log-warn:    #fbbf24;  /* amber-400 */
    --log-err:     #f87171;  /* red-400 */
    --danger-hover:#f56565;  /* red-400 (lighter) */
    --bg-deep:     #0c0c14;  /* deeper canvas for log area */
    /* Fonts — Tk uses Segoe UI, web falls back gracefully */
    --font-ui:  "Segoe UI", -apple-system, "Helvetica Neue", system-ui, sans-serif;
    --font-mono: "Consolas", "JetBrains Mono", "Cascadia Code", monospace;
  }

  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; height: 100%;
    background: var(--bg-canvas);
    color: var(--text-primary);
    font: 10pt/1.5 var(--font-ui);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  body {
    display: flex; flex-direction: column;
    height: 100vh;          /* pin to viewport so footer always at bottom (matches Tk) */
    overflow: hidden;        /* prevent body scroll; main scrolls internally */
  }

  /* ============================================================
     HEADER (ui/main_window._build_header — 72px tall, fixed)
     ============================================================ */
  header.app-header {
    height: 72px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--bg-canvas);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 16px;
    flex-shrink: 0;
  }
  .header-left { display: flex; align-items: center; gap: 8px; }
  .status-dot {
    width: 14px; height: 14px;
    background: var(--tc01);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(76,175,80,0.6);
    margin-right: 8px;
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s;
  }
  .status-dot.busy  { background: var(--warning); box-shadow: 0 0 6px rgba(245,158,11,0.6); animation: pulse 1.2s ease-in-out infinite; }
  .status-dot.error { background: var(--danger); box-shadow: 0 0 6px rgba(239,68,68,0.6); }
  @keyframes pulse { 50% { opacity: 0.5; } }

  .title-box { display: flex; flex-direction: column; line-height: 1.1; }
  .title-box .title    { font-size: 16pt; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .title-box .subtitle { font-size: 9pt;  color: var(--text-muted); margin-top: 2px; display: flex; align-items: center; gap: 8px; }

  /* Active TC badge in header */
  .active-tc-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(76,175,80,0.12);
    border: 1px solid var(--tc-accent, var(--tc01));
    border-left: 3px solid var(--tc-accent, var(--tc01));
    border-radius: 3px;
    padding: 3px 10px;
    font-size: 10pt;
    font-weight: 600;
    color: var(--text-primary);
    transition: all 0.2s;
  }
  .active-tc-badge .active-tc-dot {
    width: 8px; height: 8px;
    background: var(--tc-accent, var(--tc01));
    border-radius: 50%;
    box-shadow: 0 0 6px var(--tc-accent, var(--tc01));
  }
  .active-tc-badge .active-tc-label {
    color: var(--tc-accent, var(--tc01));
    font-family: var(--font-mono);
    font-size: 10pt;
  }
  .active-tc-badge .active-tc-name {
    font-size: 9pt;
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* GPU/encoder badge */
  .gpu-badge {
    display: inline-flex; align-items: center;
    padding: 4px 10px; border-radius: 4px;
    font-size: 9pt; font-weight: 600;
    font-family: var(--font-mono);
    margin-right: 6px;
  }
  .disk-badge {
    display: inline-flex; align-items: center;
    padding: 4px 8px; border-radius: 4px;
    margin-right: 6px;
  }
  /* Help modal */
  .help-modal-backdrop {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);
    z-index: 9999;
    display: flex; align-items: center; justify-content: center;
  }
  .help-modal {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
    max-width: 560px; max-height: 80vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }
  .help-modal h2 { font-size: 18pt; margin-bottom: 16px; color: var(--tc01); }
  .help-modal kbd {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 2px 8px;
    font-family: var(--font-mono);
    font-size: 9pt;
    color: var(--text-primary);
  }
  .help-modal table { width: 100%; border-collapse: collapse; margin: 8px 0 16px; }
  .help-modal td { padding: 6px 0; font-size: 10pt; color: var(--text-secondary); }
  .help-modal td:first-child { width: 130px; }
  .help-modal .close-btn {
    float: right; background: var(--bg-raised); border: 1px solid var(--border);
    color: var(--text-primary); padding: 6px 14px; border-radius: 4px; cursor: pointer;
  }
  .help-modal h3 { font-size: 12pt; margin: 12px 0 8px; color: var(--tc02); }
  .help-modal ul { padding-left: 20px; color: var(--text-secondary); line-height: 1.7; font-size: 10pt; }

  /* History modal (wider, table) */
  .history-modal { max-width: 880px; max-height: 80vh; }
  .history-table { width: 100%; border-collapse: collapse; font-size: 10pt; }
  .history-table th { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); color: var(--tc02); font-size: 9pt; text-transform: uppercase; }
  .history-table td { padding: 8px 10px; border-bottom: 1px solid var(--border); color: var(--text-secondary); }
  .history-table tr:hover td { background: var(--bg-raised); cursor: pointer; }
  .status-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 8pt; font-weight: 600; }
  .status-done { background: rgba(76,175,80,0.2); color: #4CAF50; }
  .status-running { background: rgba(59,130,246,0.2); color: #3B82F6; }
  .status-failed { background: rgba(239,68,68,0.2); color: #EF4444; }
  .status-cancelled { background: rgba(156,163,175,0.2); color: #9CA3AF; }
  .tc-pill { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 8pt; font-family: var(--font-mono); font-weight: 600; }
  .tc-pill-tc01 { background: var(--tc01); color: #fff; }
  .tc-pill-tc02 { background: var(--tc02); color: #fff; }
  .tc-pill-tc03 { background: var(--tc03); color: #fff; }
  .tc-pill-tc04 { background: var(--tc04); color: #fff; }
  .tc-pill-tc05 { background: var(--tc05); color: #000; }
  .tc-pill-tc06 { background: var(--tc06); color: #fff; }

  /* Presets modal */
  .presets-modal { max-width: 560px; }
  .presets-list { max-height: 400px; overflow-y: auto; }
  .preset-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border: 1px solid var(--border); border-radius: 6px; margin-bottom: 6px; background: var(--bg-raised); }
  .preset-item .preset-name { font-weight: 600; color: var(--text-primary); }
  .preset-item .preset-meta { font-size: 9pt; color: var(--text-muted); }
  .preset-item button { margin-left: 6px; padding: 4px 10px; font-size: 9pt; }
  .preset-empty { text-align: center; color: var(--text-muted); padding: 30px; font-size: 10pt; }

  /* Thumbnail gallery grid */
  .thumb-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 10px;
    max-height: 65vh;
    overflow-y: auto;
    padding: 8px;
  }
  .thumb-card {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    transition: transform 0.15s, border-color 0.15s;
    cursor: pointer;
  }
  .thumb-card:hover { transform: translateY(-2px); border-color: var(--tc01); }
  .thumb-card img {
    width: 100%; height: auto; display: block; aspect-ratio: 9/16; object-fit: cover;
    background: #000;
  }
  .thumb-name {
    font-size: 8pt; padding: 4px 6px; color: var(--text-secondary);
    font-family: var(--font-mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .thumb-dl {
    width: 100%; padding: 4px 0; background: var(--tc01); color: #000;
    border: none; font-size: 9pt; font-weight: 600; cursor: pointer;
  }
  .thumb-dl:hover { background: var(--tc02); color: #fff; }
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 9pt;
  }
  .version-tag {
    background: var(--bg-raised);
    color: var(--text-muted);
    padding: 1px 6px;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 8pt;
  }

  .header-right { display: flex; align-items: center; gap: 4px; }
  .header-btn {
    background: var(--bg-raised);
    color: var(--text-primary);
    border: none;
    padding: 6px 12px;
    font: 10pt var(--font-ui);
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.12s;
  }
  .header-btn:hover { background: var(--bg-hover); }

  /* ============================================================
     TABS (ui/main_window.TNotebook — 6 accent tabs)
     ============================================================ */
  nav.tabs {
    background: var(--bg-canvas);
    padding: 8px 16px 0;
    display: flex;
    gap: 0;
    flex-shrink: 0;
    border-bottom: 1px solid var(--bg-canvas);
  }
  .tab {
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--bg-canvas);
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 10px 20px;
    font: 10pt var(--font-ui);
    cursor: pointer;
    position: relative;
    transition: background 0.12s, color 0.12s;
    user-select: none;
  }
  .tab:hover:not(.disabled):not(.active) { background: var(--bg-raised); }
  .tab.active {
    background: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 600;
    z-index: 2;
  }
  .tab.active::after {
    content: ""; position: absolute; left: 0; right: 0; top: 0;
    height: 3px;
    background: var(--tab-accent, var(--tc01));
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
  }
  .tab.disabled { opacity: 0.45; cursor: not-allowed; }
  .tab .swatch {
    display: inline-block; width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--tab-accent);
    margin-right: 6px;
    vertical-align: middle;
  }

  /* ============================================================
     TAB CONTENT (bg-surface)
     ============================================================ */
  main.tab-content {
    background: var(--bg-canvas);
    padding: 0 16px;
    flex: 1 1 auto;
    min-height: 0;          /* allow shrinking so internal scroll works */
    overflow-y: auto;       /* scroll inside main, not body */
  }
  .tab-pane { display: none; }
  .tab-pane.active { display: block; }
  .tab-pane > .scrollable {
    max-width: 1400px;
    margin: 0 auto;
    padding: 16px 0;
  }

  /* ============================================================
     DROP ZONES (ui/components/drop_zone.py — colored when filled)
     ============================================================ */
  .zones {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  @media (max-width: 900px) { .zones { grid-template-columns: 1fr; } }

  .dz {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
    transition: border-color 0.12s, background 0.12s;
    position: relative;
  }
  .dz:hover { border-color: var(--border-focus); }
  .dz.over  { background: var(--bg-hover); border-color: var(--border-focus); }
  .dz.filled { border-color: var(--dz-accent, var(--tc01)); }
  .dz .dz-title {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 10pt;
    display: flex; align-items: center; justify-content: space-between;
  }
  .dz .dz-count {
    background: var(--bg-raised);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 8pt;
    padding: 1px 6px;
    border-radius: 8px;
  }
  .dz.filled .dz-count {
    background: var(--dz-accent, var(--tc01));
    color: #000;
    font-weight: 600;
  }
  .dz .dz-hint {
    color: var(--text-muted);
    font-size: 9pt;
    margin-top: 2px;
    margin-bottom: 8px;
  }
  .dz .dz-empty {
    background: var(--bg-card);
    border-radius: 4px;
    padding: 12px 0 8px;
    text-align: center;
    cursor: pointer;
    user-select: none;
  }
  .dz .dz-icon  { font-size: 30pt; line-height: 1; opacity: 0.55; }
  .dz .dz-headline {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 12pt;
    margin-top: 4px;
  }
  .dz .dz-sub {
    color: var(--text-muted);
    font-size: 12pt;
    margin-top: 2px;
  }
  .dz .dz-status {
    color: var(--text-muted);
    font-size: 9pt;
    margin-top: 8px;
    font-family: var(--font-mono);
  }
  .dz .dz-files { margin-top: 8px; display: none; }
  .dz.filled .dz-files { display: block; }
  .dz .file-row {
    display: flex; align-items: center; gap: 6px;
    padding: 4px 6px;
    background: var(--bg-raised);
    border-radius: 3px;
    margin-top: 4px;
    font-size: 9pt;
  }
  .dz .file-row .fname { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dz .file-row .ftype {
    background: var(--bg-card);
    color: var(--text-secondary);
    padding: 0 5px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 7pt;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .dz .file-row .del   {
    color: var(--text-muted); cursor: pointer; font-size: 12pt; line-height: 1;
    padding: 0 4px;
  }
  .dz .file-row .del:hover { color: var(--danger); }
  .dz input[type=file] { display: none; }

  /* ============================================================
     SETTINGS PANEL (ui/components/settings_panel.py — LabelFrame)
     ============================================================ */
  .panel {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    margin-top: 12px;
  }
  .panel-header {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 12pt;
    font-weight: 600;
    color: var(--text-primary);
  }
  .panel-body { padding: 12px 14px; }

  .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 14px;
  }
  .field-grid .field { display: flex; flex-direction: column; }
  .field-grid .field.full { grid-column: 1 / -1; }
  .field label {
    font-size: 9pt;
    color: var(--text-secondary);
    margin-bottom: 3px;
    font-weight: 600;
  }
  .field label .req { color: var(--tc01); margin-left: 3px; }
  .field label .opt { color: var(--text-muted); font-weight: 400; margin-left: 4px; }
  .field input[type=text],
  .field input[type=number],
  .field select {
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 5px 8px;
    font: 10pt var(--font-ui);
    transition: border-color 0.12s;
  }
  .field input:focus, .field select:focus { outline: none; border-color: var(--border-focus); }
  .field input[type=color] {
    width: 100%;
    height: 28px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
    padding: 2px;
  }
  .field .help { font-size: 8pt; color: var(--text-muted); margin-top: 2px; line-height: 1.4; white-space: pre-line; }

  /* ============================================================
     COUNT + ACTION BAR (ui/components/action_bar.py)
     ============================================================ */
  .count-line {
    color: var(--text-muted);
    font-size: 10pt;
    margin: 14px 0 8px;
    padding: 8px 12px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--tc-accent, var(--tc01));
    border-radius: 4px;
    display: flex; align-items: center; gap: 12px;
    flex-wrap: wrap;
  }
  .count-line b { color: var(--text-primary); }
  .count-line b.acc { color: var(--tc-accent, var(--tc01)); font-family: var(--font-mono); font-size: 12pt; }
  .count-line .breakdown { color: var(--text-secondary); font-family: var(--font-mono); font-size: 9pt; }

  .action-bar { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .btn {
    padding: 9px 18px;
    border: none;
    border-radius: 4px;
    font: 600 10pt var(--font-ui);
    cursor: pointer;
    transition: background 0.12s, opacity 0.12s;
    white-space: nowrap;        /* prevent emoji+Thai from squeezing */
    display: inline-flex;       /* align emoji + text vertically centered */
    align-items: center;
    gap: 6px;
    line-height: 1.2;
    min-height: 32px;
  }
  .btn-primary {
    background: var(--current-tc, var(--tc01));
    color: #fff;
    transition: background 0.2s;
  }
  .btn-primary:hover:not(:disabled) {
    filter: brightness(1.15);
  }
  .btn-primary:disabled { background: var(--bg-raised); color: var(--text-disabled); cursor: not-allowed; }
  .btn-secondary {
    background: var(--bg-raised);
    color: var(--text-primary);
    border: 1px solid var(--border);
    font-weight: 400;
    padding: 7px 14px;
    min-width: 100px;
    justify-content: center;
  }
  .btn-secondary:hover:not(:disabled) { background: var(--bg-hover); }
  .btn-secondary:disabled { color: var(--text-disabled); cursor: not-allowed; }
  .btn-muted {
    background: var(--bg-surface);
    color: var(--text-muted);
    padding: 6px 10px;
    font-size: 9pt;
    font-weight: 400;
  }
  .btn-muted:hover { background: var(--bg-card); color: var(--text-secondary); }
  .btn-danger {
    background: var(--danger);
    color: #fff;
    font-weight: 600;
    padding: 7px 12px;
  }
  .btn-danger:hover:not(:disabled) { background: var(--danger-hover); }

  /* ============================================================
     PROGRESS + LOG
     ============================================================ */
  .progress-row {
    display: flex; align-items: center; gap: 10px;
    margin: 8px 0;
  }
  .progress-bar {
    flex: 1;
    height: 14px;
    background: var(--bg-card);
    border-radius: 3px;
    overflow: hidden;
    position: relative;
  }
  .progress-bar .fill {
    height: 100%;
    background: var(--tc01);
    width: 0%;
    transition: width 0.2s;
  }
  .progress-info {
    font-size: 9pt;
    color: var(--text-secondary);
    min-width: 120px;
    text-align: right;
    font-family: var(--font-mono);
  }

  .log-frame {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    margin-top: 12px;
    flex: 1;
    display: flex; flex-direction: column;
    min-height: 200px;
    max-height: 360px;
  }
  .log-header {
    padding: 8px 14px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    font-weight: 600;
    font-size: 11pt;
  }
  .log-body {
    flex: 1; overflow-y: auto;
    padding: 8px 14px;
    font: 9pt/1.5 var(--font-mono);
    color: var(--text-secondary);
    background: var(--bg-deep);
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
  }
  .log-body .line { white-space: pre-wrap; word-break: break-all; }
  .log-body .line.info  { color: var(--log-info); }
  .log-body .line.ok    { color: var(--log-ok); }
  .log-body .line.warn  { color: var(--log-warn); }
  .log-body .line.err   { color: var(--log-err); }

  /* ============================================================
     STATUS BAR (ui/main_window._build_status_bar — 26px, dark card)
     ============================================================ */
  footer.status-bar {
    height: 26px;
    background: var(--bg-card);
    color: var(--text-secondary);
    font: 9pt var(--font-ui);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 16px;
    flex-shrink: 0;
    border-top: 1px solid var(--bg-canvas);
  }
  .status-bar .left, .status-bar .right { display: flex; align-items: center; gap: 8px; }
  .status-bar .sep { color: var(--text-muted); }
  .status-bar .debug-on  { color: var(--warning); }
  .status-bar .busy-idle { color: var(--tc01); font-weight: 600; }
  .status-bar .busy-busy { color: var(--warning); font-weight: 600; }

  /* ============================================================
     PIPELINE PROGRESS BADGES (TC02-04)
     ============================================================ */
  .pipeline-badges {
    display: flex; align-items: stretch; gap: 6px;
    margin-bottom: 12px;
    padding: 8px 12px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--tc-accent, var(--tc02));
    border-radius: 6px;
    transition: border-color 0.2s;
  }
  .pipeline-step {
    display: flex; align-items: center; gap: 8px;
    padding: 6px 10px;
    background: var(--bg-raised);
    border-radius: 4px;
    flex: 1;
    transition: all 0.2s;
  }
  .pipeline-step.running { background: rgba(245,158,11,0.12); border: 1px solid var(--warning); }
  .pipeline-step.done    { background: rgba(76,175,80,0.12); border: 1px solid var(--tc01); }
  .pipeline-step.error   { background: rgba(239,68,68,0.12); border: 1px solid var(--danger); }
  .pipeline-step .step-num {
    width: 26px; height: 26px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700;
    font-size: 11pt;
    color: var(--text-secondary);
    flex-shrink: 0;
  }
  .pipeline-step.running .step-num { background: var(--warning); color: #000; border-color: var(--warning); }
  .pipeline-step.done    .step-num { background: var(--tc01); color: #000; border-color: var(--tc01); }
  .pipeline-step .step-info { line-height: 1.2; }
  .pipeline-step .step-name { font-size: 10pt; font-weight: 600; color: var(--text-primary); }
  .pipeline-step .step-status { font-size: 8pt; color: var(--text-muted); margin-top: 2px; font-family: var(--font-mono); }
  .pipeline-step.running .step-status { color: var(--warning); }
  .pipeline-step.done    .step-status { color: var(--tc01); }
  .pipeline-step.error   .step-status { color: var(--danger); }
  .pipeline-arrow {
    display: flex; align-items: center;
    color: var(--text-muted);
    font-size: 14pt;
    font-weight: 700;
  }

  /* ============================================================
     7x3 REFRAME MATRIX (TC02/TC04 only)
     ============================================================ */
  .mx {
    display: inline-block;
    min-width: 36px;
    padding: 3px 8px;
    background: var(--tc02);
    color: white;
    border-radius: 3px;
    font-weight: 600;
    font-size: 8pt;
  }
  .mx.disabled { background: var(--bg-card); color: var(--text-muted); }

  /* ============================================================
     TOAST NOTIFICATIONS (top-right slide-in)
     ============================================================ */
  .toast-stack {
    position: fixed; top: 88px; right: 16px;
    z-index: 1000;
    display: flex; flex-direction: column; gap: 8px;
    pointer-events: none;
  }
  .toast {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--tc01);
    border-radius: 6px;
    padding: 12px 18px;
    min-width: 280px;
    max-width: 360px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    color: var(--text-primary);
    font-size: 10pt;
    display: flex; align-items: center; gap: 10px;
    pointer-events: auto;
    animation: toast-in 0.25s ease-out;
  }
  .toast.fade-out { animation: toast-out 0.25s ease-in forwards; }
  .toast .toast-icon { font-size: 16pt; line-height: 1; }
  .toast .toast-body { flex: 1; }
  .toast .toast-title { font-weight: 600; margin-bottom: 2px; }
  .toast .toast-msg   { color: var(--text-secondary); font-size: 9pt; }
  .toast .toast-close {
    color: var(--text-muted); cursor: pointer; padding: 0 4px;
    font-size: 14pt; line-height: 1;
  }
  .toast .toast-close:hover { color: var(--text-primary); }
  .toast.success { border-left-color: var(--tc01); }
  .toast.success .toast-icon { color: var(--tc01); }
  .toast.info    { border-left-color: var(--info); }
  .toast.info    .toast-icon { color: var(--info); }
  .toast.warn    { border-left-color: var(--warning); }
  .toast.warn    .toast-icon { color: var(--warning); }
  .toast.error   { border-left-color: var(--danger); }
  .toast.error   .toast-icon { color: var(--danger); }
  @keyframes toast-in {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes toast-out {
    from { opacity: 1; transform: translateX(0); }
    to   { opacity: 0; transform: translateX(20px); }
  }

  /* Small responsive niceties */
  @media (max-width: 720px) {
    header.app-header { height: auto; padding: 12px 14px; flex-wrap: wrap; gap: 8px; }
    .title-box .title    { font-size: 14pt; }
    nav.tabs { overflow-x: auto; }
    .tab { padding: 8px 14px; font-size: 9pt; }
    footer.status-bar { font-size: 8pt; padding: 0 8px; }
  }


/* ==================== Video Gallery (v3.GALLERY) ==================== */
.gallery-section {
  margin: 0;
  padding: 16px 20px 12px;
  background: linear-gradient(180deg, #0d1428 0%, #0a0f1f 100%);
  border-bottom: 1px solid var(--border);
}
.gallery-header {
  display: flex; align-items: center; gap: 12px;
  margin-bottom: 12px; flex-wrap: wrap;
}
.gallery-header h3 {
  margin: 0; font-size: 13pt; color: var(--text-bright);
  display: flex; align-items: center; gap: 8px;
}
.gallery-filters { display: flex; gap: 4px; flex-wrap: wrap; }
.gallery-filters button {
  background: var(--bg-elevated); color: var(--text);
  border: 1px solid var(--border); border-radius: 4px;
  padding: 4px 10px; font-size: 9pt; cursor: pointer;
  transition: all 0.15s ease;
}
.gallery-filters button:hover { background: var(--bg-card); }
.gallery-filters button.active {
  background: var(--accent); color: #0a0f1f; border-color: var(--accent);
  font-weight: 600;
}
.gallery-stats {
  margin-left: auto; font-size: 9pt; color: var(--text-muted);
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 12px; margin-bottom: 12px;
  min-height: 200px;
}
.gallery-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: 6px; overflow: hidden; cursor: pointer;
  transition: all 0.15s ease; position: relative;
}
.gallery-card:hover {
  border-color: var(--accent); transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(0, 255, 136, 0.15);
}
.gallery-card .thumb {
  width: 100%; aspect-ratio: 16/9; background: #000;
  object-fit: cover; display: block;
}
.gallery-card .thumb-loading {
  width: 100%; aspect-ratio: 16/9; background: #0a0f1f;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-muted); font-size: 9pt;
}
.gallery-card .meta { padding: 8px 10px; }
.gallery-card .name {
  font-size: 9pt; color: var(--text-bright);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  font-family: var(--mono);
}
.gallery-card .info {
  font-size: 8pt; color: var(--text-muted);
  margin-top: 4px; display: flex; gap: 8px;
}
.gallery-card .play-icon {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 48px; height: 48px; border-radius: 50%;
  background: rgba(0, 0, 0, 0.7); display: flex;
  align-items: center; justify-content: center;
  font-size: 18pt; color: white; opacity: 0;
  transition: opacity 0.15s ease; pointer-events: none;
}
.gallery-card:hover .play-icon { opacity: 1; }
.gallery-empty, .gallery-error {
  grid-column: 1 / -1; text-align: center; padding: 40px;
  color: var(--text-muted); font-size: 10pt;
}
.gallery-paging {
  display: flex; align-items: center; justify-content: center;
  gap: 8px; padding-top: 8px;
}
.gallery-paging button {
  background: var(--bg-elevated); color: var(--text);
  border: 1px solid var(--border); border-radius: 4px;
  padding: 6px 14px; font-size: 9pt; cursor: pointer;
}
.gallery-paging button:hover:not(:disabled) {
  background: var(--bg-card); border-color: var(--accent);
}
.gallery-paging button:disabled {
  opacity: 0.4; cursor: not-allowed;
}
.gallery-paging .page-info {
  font-size: 9pt; color: var(--text-muted);
  font-family: var(--mono);
}
.gallery-paging .page-jump {
  background: var(--bg-elevated); color: var(--text);
  border: 1px solid var(--border); border-radius: 4px;
  padding: 6px 8px; font-size: 9pt; width: 60px;
  text-align: center; font-family: var(--mono);
}

/* Video player modal */
.gallery-modal {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.92);
  display: none; z-index: 9999; align-items: center;
  justify-content: center; flex-direction: column;
}
.gallery-modal.show { display: flex; }
.gallery-modal video {
  max-width: 90vw; max-height: 85vh; background: #000;
  border-radius: 4px;
}
.gallery-modal .modal-close {
  position: absolute; top: 16px; right: 16px;
  background: rgba(0, 0, 0, 0.7); color: white;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%; width: 40px; height: 40px;
  font-size: 18pt; cursor: pointer; display: flex;
  align-items: center; justify-content: center;
}
.gallery-modal .modal-close:hover { background: var(--accent); color: #000; }
.gallery-modal .modal-name {
  color: white; font-size: 10pt; margin-top: 12px;
  font-family: var(--mono); max-width: 90vw; text-align: center;
  word-break: break-all;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" type="13db993d3a7f54f9fd842fb2-text/javascript"></script>
</head>
<body>

<!-- ================================================================
     VIDEO GALLERY (v3.GALLERY)
     - 5 items per page, click to play, pagination + dir filter
     ================================================================ -->
<section class="gallery-section" id="gallerySection">
  <div class="gallery-header">
    <h3>📺 Video Gallery</h3>
    <div class="gallery-filters" id="galleryFilters">
      <button data-dir="" class="active">All</button>
      <button data-dir="tc01">TC01</button>
      <button data-dir="tc02">TC02</button>
      <button data-dir="tc03">TC03</button>
      <button data-dir="tc04">TC04</button>
      <button data-dir="tc05">TC05</button>
      <button data-dir="tc06">TC06</button>
    </div>
    <div class="gallery-stats" id="galleryStats">Loading…</div>
  </div>
  <div class="gallery-grid" id="galleryGrid"></div>
  <div class="gallery-paging" id="galleryPaging">
    <button id="galleryPrev" disabled>◀ Prev</button>
    <span class="page-info" id="galleryPageInfo">— / —</span>
    <button id="galleryNext" disabled>Next ▶</button>
    <input type="number" min="1" class="page-jump" id="galleryJump" placeholder="#" title="Jump to page" />
    <button id="galleryRefresh" title="Refresh">🔄</button>
  </div>
</section>

<!-- Video player modal -->
<div class="gallery-modal" id="galleryModal">
  <button class="modal-close" id="galleryModalClose" title="Close (Esc)">×</button>
  <video id="galleryVideo" controls preload="metadata"></video>
  <div class="modal-name" id="galleryModalName"></div>
</div>

<!-- ================================================================
     HEADER (height 72px)
     - status dot 14x14 + title "🟢 SJ88 Green Screen" + subtitle
     - right: "☀️ Light" + "📁 เปิด Output"
     ================================================================ -->
<header class="app-header">
  <div class="header-left">
    <div class="status-dot" id="statusDot" title="คลิกเพื่อ refresh ffmpeg status"></div>
    <div class="title-box">
      <div class="title">
        🟢 SJ88 Green Screen
        <span class="active-tc-badge" id="activeTCBadge" style="--tc-accent: var(--tc01)">
          <span class="active-tc-dot"></span>
          <span class="active-tc-label">TC01</span>
          <span class="active-tc-name">ตัดจอเขียว</span>
        </span>
      </div>
      <div class="subtitle">ตัดจอเขียว • ออโต้ซูม • แบทช์  <span class="version-tag">v1.1.1</span></div>
    </div>
  </div>
  <div class="header-right">
    <span class="gpu-badge" id="gpuBadge" title="Encoder (auto-detected at render time)" style="background:rgba(76,175,80,0.08);border:1px solid var(--border);color:var(--text-muted);">⚙️ detecting…</span>
    <span class="disk-badge" id="diskBadge" title="Disk free" style="background:rgba(76,175,80,0.08);border:1px solid var(--border);color:var(--text-muted);font-size:9pt;">💾 —</span>
    <button class="header-btn" id="presetsBtn" title="Saved settings presets (Ctrl+S)">⭐ Presets</button>
    <button class="header-btn" id="historyBtn" title="Job history (Ctrl+H)">📜 ประวัติ</button>
    <button class="header-btn" id="helpBtn" title="Keyboard shortcuts & help (?)">❓ Help</button>
    <button class="header-btn" id="themeBtn" title="สลับ Dark/Light (Ctrl+T)">☀️ Light</button>
    <button class="header-btn" id="openOutputBtn" title="เปิด output folder (Ctrl+O)">📁 เปิด Output</button>
    <button class="header-btn" id="authBtn" title="ตั้งค่า API token สำหรับ render และ output">🔐 API token</button>
  </div>
</header>

<!-- ================================================================
     TABS (6 notebook tabs, TC01 active)
     ================================================================ -->
<nav class="tabs" role="tablist">
  <button class="tab active" data-tab="tc01" style="--tab-accent: var(--tc01);">
    <span class="swatch"></span>🎬 ตัดจอเขียว (TC01)
  </button>
  <button class="tab" data-tab="tc02" style="--tab-accent: var(--tc02);" title="ออโต้ซูม 7×3 (Reframe + Chroma)">
    <span class="swatch"></span>🎯 ออโต้ซูม 7×3 (TC02)
  </button>
  <button class="tab" data-tab="tc03" style="--tab-accent: var(--tc03);" title="ตัดจอเขียว + หั่นช่วง (Chroma + Batch)">
    <span class="swatch"></span>📦 ตัดจอเขียว + หั่นช่วง (TC03)
  </button>
  <button class="tab" data-tab="tc04" style="--tab-accent: var(--tc04);" title="ออโต้ซูม + หั่นช่วง (Reframe + Batch + Chroma)">
    <span class="swatch"></span>🚀 ออโต้ซูม + หั่นช่วง (TC04)
  </button>
  <button class="tab" data-tab="tc05" style="--tab-accent: var(--tc05);" title="ออโต้ซูมล้วน ไม่มี chroma (Reframe Only)">
    <span class="swatch"></span>🎞️ ออโต้ซูมล้วน (TC05)
  </button>
  <button class="tab" data-tab="tc06" style="--tab-accent: var(--tc06);" title="Chroma หลาย product + Audio master">
    <span class="swatch"></span>🎵 Chroma Audio Master (TC06)
  </button>
  <button class="tab" data-tab="stats" style="--tab-accent: #6fcf97;" title="greenstats.sj88ai.com realtime">
    <span class="swatch"></span>📊 Stats
  </button>
</nav>

<!-- ================================================================
     TAB CONTENT
     ================================================================ -->
<main class="tab-content">
  <div class="tab-pane active" data-pane="tc01">
    <div class="scrollable">

      <!-- Pipeline progress badges (TC02-04) -->
      <div class="pipeline-badges" id="pipelineBadges" data-tc-show="tc02 tc03 tc04" style="display:none">
        <div class="pipeline-step" data-step="1">
          <div class="step-num">1</div>
          <div class="step-info">
            <div class="step-name" data-step-name="tc02">Reframe</div>
            <div class="step-name" data-step-name="tc03" style="display:none">Split</div>
            <div class="step-name" data-step-name="tc04">Reframe</div>
            <div class="step-status" data-step-status>⏳ waiting</div>
          </div>
        </div>
        <div class="pipeline-step" data-step="2">
          <div class="step-num">2</div>
          <div class="step-info">
            <div class="step-name" data-step-name="tc02">Chroma</div>
            <div class="step-name" data-step-name="tc03" style="display:none">Chroma</div>
            <div class="step-name" data-step-name="tc04">Split</div>
            <div class="step-status" data-step-status>⏳ waiting</div>
          </div>
        </div>
        <div class="pipeline-arrow">→</div>
        <div class="pipeline-step" data-step="3" data-step-only="tc04">
          <div class="step-num">3</div>
          <div class="step-info">
            <div class="step-name" data-step-name="tc04">Chroma</div>
            <div class="step-status" data-step-status>⏳ waiting</div>
          </div>
        </div>
      </div>

      <!-- 4 Drop Zones (2x2) -->
      <div class="zones">
        <!-- Cover (optional) -->
        <div class="dz" data-zone="cover" style="--dz-accent: var(--tc01);">
          <div class="dz-title">🖼️ Cover (optional) <span class="dz-count" data-count="cover">0</span></div>
          <div class="dz-hint">intro card (ไม่บังคับ)</div>
          <div class="dz-empty">
            <div class="dz-icon">📁</div>
            <div class="dz-headline">ลากไฟล์มาวางที่นี่</div>
            <div class="dz-sub">หรือ  คลิกเพื่อเลือก</div>
            <input type="file" multiple
              accept=".mp4,.mov,.mkv,.avi,.m4v,.webm,.png,.jpg,.jpeg,.webp,.bmp" />
          </div>
          <div class="dz-status">📂 ลากไฟล์มาวาง  •  คลิกเลือก  •  Ctrl+V วาง path</div>
          <div class="dz-files"></div>
        </div>

        <!-- Product (จอเขียว) — required -->
        <div class="dz" data-zone="product" style="--dz-accent: var(--tc01);">
          <div class="dz-title">🎬 Product (จอเขียว) <span style="color:var(--tc01);">*</span> <span class="dz-count" data-count="product">0</span></div>
          <div class="dz-hint">multi-select  •  1+ ไฟล์</div>
          <div class="dz-empty">
            <div class="dz-icon">📁</div>
            <div class="dz-headline">ลากไฟล์มาวางที่นี่</div>
            <div class="dz-sub">หรือ  คลิกเพื่อเลือก</div>
            <input type="file" multiple
              accept=".mp4,.mov,.mkv,.avi,.m4v,.webm" />
          </div>
          <div class="dz-status">📂 ลากไฟล์มาวาง  •  คลิกเลือก  •  Ctrl+V วาง path</div>
          <div class="dz-files"></div>
        </div>

        <!-- Background — required -->
        <div class="dz" data-zone="bg" style="--dz-accent: var(--tc01);">
          <div class="dz-title">🌄 Background <span style="color:var(--tc01);">*</span> <span class="dz-count" data-count="bg">0</span></div>
          <div class="dz-hint">multi-select  •  1+ ไฟล์</div>
          <div class="dz-empty">
            <div class="dz-icon">📁</div>
            <div class="dz-headline">ลากไฟล์มาวางที่นี่</div>
            <div class="dz-sub">หรือ  คลิกเลือก</div>
            <input type="file" multiple
              accept=".mp4,.mov,.mkv,.avi,.m4v,.webm,.png,.jpg,.jpeg,.webp,.bmp" />
          </div>
          <div class="dz-status">📂 ลากไฟล์มาวาง  •  คลิกเลือก  •  Ctrl+V วาง path</div>
          <div class="dz-files"></div>
        </div>

        <!-- Audio (optional) -->
        <div class="dz" data-zone="audio" style="--dz-accent: var(--tc01);">
          <div class="dz-title">🎵 Audio (optional) <span class="dz-count" data-count="audio">0</span></div>
          <div class="dz-hint">ถ้าใส่: final ยาวเท่า Audio  •  ไม่ใส่: รักษาเสียง/ความยาว Product</div>
          <div class="dz-empty">
            <div class="dz-icon">📁</div>
            <div class="dz-headline">ลากไฟล์มาวางที่นี่</div>
            <div class="dz-sub">หรือ  คลิกเลือก</div>
            <input type="file" multiple
              accept=".mp3,.wav,.m4a,.aac,.flac,.ogg" />
          </div>
          <div class="dz-status">📂 ลากไฟล์มาวาง  •  คลิกเลือก  •  Ctrl+V วาง path</div>
          <div class="dz-files"></div>
        </div>
      </div>

      <!-- Settings: Chroma / Final output -->
      <div class="panel">
        <div class="panel-header">🟢 Chroma / Final output — ค่าชุดเดียวกัน TC01-TC04, TC06</div>
        <div class="panel-body">
          <div class="field-grid">
            <div class="field">
              <label>🟢 Key Color <span class="req">*</span></label>
              <input type="color" id="f-key_color" value="#00ff00" />
              <div class="help">สีพื้นหลังที่จะลบออก (hex)
ค่าเริ่มต้น #00FF00 = pure green
ถ้าพื้นหลังเป็นสีอื่นให้เลือกสีจริงจาก Color Picker</div>
            </div>
            <div class="field">
              <label>🎯 Similarity <span class="req">*</span></label>
              <input type="number" id="f-similarity" value="0.29" min="0" max="1" step="0.01" />
              <div class="help">ช่วงความคล้ายของสีที่จะลบ (0.0-1.0)
ค่าน้อย = เลือกสีแคบ; ค่ามาก = ลบสีใกล้เคียงมากขึ้น</div>
            </div>
            <div class="field">
              <label>🌫️ Blend <span class="req">*</span></label>
              <input type="number" id="f-blend" value="0.04" min="0" max="1" step="0.01" />
              <div class="help">ความนุ่มของขอบ matte (0.0-1.0)
0.0 = ขอบคม; ค่าสูงขึ้นทำให้ขอบนุ่มขึ้น</div>
            </div>
            <div class="field">
              <label>🧽 Despill <span class="req">*</span></label>
              <input type="number" id="f-despill" value="0.32" min="0" max="1" step="0.01" />
              <div class="help">ลดสีเขียว/สี key ที่สะท้อนบนวัตถุ (0.0-1.0)
0.0 = ปิด; ค่าเริ่มต้น 0.32</div>
            </div>
            <div class="field">
              <label>📐 Width (px)</label>
              <input type="number" id="f-width" value="1080" min="360" max="3840" step="2" />
              <div class="help">ความกว้าง final output; ต้องเป็นเลขคู่ 360-3840</div>
            </div>
            <div class="field">
              <label>📐 Height (px)</label>
              <input type="number" id="f-height" value="1920" min="360" max="3840" step="2" />
              <div class="help">ความสูง final output; ต้องเป็นเลขคู่ 360-3840</div>
            </div>
            <div class="field">
              <label>🎞️ FPS</label>
              <input type="number" id="f-fps" value="30" min="15" max="60" step="1" />
              <div class="help">Frame rate ของ final Chroma output (15-60)</div>
            </div>
            <div class="field">
              <label>📊 Bitrate</label>
              <input type="text" id="f-bitrate" value="6000k" />
              <div class="help">Video bitrate ของ final Chroma output เช่น 6000k</div>
            </div>
            <div class="field">
              <label>🎬 Encoder</label>
              <select id="f-encoder">
                <option value="auto">auto (auto-detect hardware)</option>
                <option value="libx264">libx264</option>
                <option value="h264_nvenc">h264_nvenc (NVIDIA)</option>
                <option value="h264_qsv">h264_qsv (Intel)</option>
                <option value="h264_amf">h264_amf (AMD)</option>
                <option value="h264_videotoolbox">h264_videotoolbox (macOS)</option>
              </select>
              <div class="help">Encoder สำหรับ final Chroma output; auto ใช้ตัวตรวจ hardware เลือกให้</div>
            </div>
            <div class="field">
              <label>⚡ Final chroma preset</label>
              <select id="f-preset">
                <option value="ultrafast">ultrafast</option>
                <option value="superfast">superfast</option>
                <option value="veryfast">veryfast</option>
                <option value="faster">faster</option>
                <option value="fast">fast</option>
                <option value="medium" selected>medium</option>
                <option value="slow">slow</option>
                <option value="slower">slower</option>
                <option value="veryslow">veryslow</option>
              </select>
              <div class="help">Preset สำหรับ encode final Chroma output</div>
            </div>
            <div class="field">
              <label>Chroma quality (v3.OPT)</label>
              <select id="f-chroma-downscale">
                <option value="0">Best (full chroma, ~17s)</option>
                <option value="2">Balanced (half chroma, ~10s)</option>
                <option value="3" selected>Fast (third chroma, ~6.5s) - 1.5x faster than balanced ⭐</option>
                <option value="4">Fastest (quarter chroma, ~5s) - 2x faster, visible edge softening</option>
              </select>
              <div class="help">v3.OPT: Chroma at lower res + GPU upscale. D=3 ⭐ default = best speed/quality balance on WSL/RTX 4060.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Settings: Matching (TC01 only) -->
      <div class="panel" data-tc-show="tc01">
        <div class="panel-header">🎲 Matching — ทำซ้ำการจับคู่ Product/Background</div>
        <div class="panel-body">
          <div class="field-grid">
            <div class="field">
              <label>🎲 Run seed (0 = auto)</label>
              <input type="number" id="f-seed" value="0" min="0" max="999999" step="1" />
              <div class="help">0 = สร้าง seed ใหม่อัตโนมัติ; 1-999999 = ทำซ้ำการจับคู่
Product/Background/Audio ตาม pipeline นั้น</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Settings: Reframe (TC02, TC04, TC05) -->
      <div class="panel" data-tc-show="tc02 tc04 tc05" style="display:none">
        <div class="panel-header" style="color: var(--tc02)">🔍 Reframe — 7 lenses × composition</div>
        <div class="panel-body">
          <div class="field-grid">
            <div class="field">
              <label>Composition: center</label>
              <select id="f-use_center" style="width:100%">
                <option value="true" selected>✅ ใช้ (C)</option>
                <option value="false">— ไม่ใช้</option>
              </select>
              <div class="help">จัดองค์ประกอบภาพให้ subject อยู่ <b>กลาง</b> เฟรม (default)</div>
            </div>
            <div class="field">
              <label>Composition: left</label>
              <select id="f-use_left" style="width:100%">
                <option value="true" selected>✅ ใช้ (L)</option>
                <option value="false">— ไม่ใช้</option>
              </select>
              <div class="help">จัดให้ subject อยู่ <b>ซ้าย</b> ของเฟรม (rule-of-thirds)</div>
            </div>
            <div class="field">
              <label>Composition: right</label>
              <select id="f-use_right" style="width:100%">
                <option value="true" selected>✅ ใช้ (R)</option>
                <option value="false">— ไม่ใช้</option>
              </select>
              <div class="help">จัดให้ subject อยู่ <b>ขวา</b> ของเฟรม (rule-of-thirds)</div>
            </div>
            <div class="field">
              <label>⚙️ Reframe workers</label>
              <input type="number" id="f-max_parallel" value="3" min="1" max="10" step="1" />
              <div class="help">จำนวน worker threads (1-10) — มากขึ้น = render เร็วขึ้น แต่ใช้ CPU/RAM มากขึ้น</div>
            </div>
            <div class="field full">
              <label>🔍 Reframe mode</label>
              <select id="f-reframe_mode" style="width:100%">
                <option value="speed" selected>speed — เร็ว (default)</option>
                <option value="lite_tilt">lite_tilt — เอียงเล็กน้อย</option>
                <option value="legacy">legacy — โหมดเก่า</option>
              </select>
              <div class="help">algorithm สำหรับ reframe — speed เร็วสุด เหมาะกับ video ทั่วไป</div>
            </div>
          </div>

          <!-- 7x3 visual matrix -->
          <div style="margin-top:14px;padding:10px;background:var(--bg-raised);border-radius:6px">
            <div style="font-size:9pt;color:var(--text-muted);margin-bottom:6px">📊 7×3 Output Matrix (lens × composition) — แต่ละ product จะถูก reframe เป็น <b id="matrixCount">7</b> outputs</div>
            <table style="width:100%;font-size:9pt;border-collapse:collapse">
              <thead><tr>
                <th style="text-align:right;padding:4px 6px;color:var(--text-muted)">lens \ comp</th>
                <th style="text-align:center;padding:4px;background:var(--tc02);color:white;border-radius:3px">C</th>
                <th style="text-align:center;padding:4px;background:var(--tc02);color:white;border-radius:3px">L</th>
                <th style="text-align:center;padding:4px;background:var(--tc02);color:white;border-radius:3px">R</th>
              </tr></thead>
              <tbody id="matrixBody">
                <tr><td style="text-align:right;padding:4px 6px;color:var(--text-secondary)">16mm</td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens16mm" data-comp="center">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens16mm" data-comp="left">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens16mm" data-comp="right">OK</span></td></tr>
                <tr><td style="text-align:right;padding:4px 6px;color:var(--text-secondary)">35mm</td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens35mm" data-comp="center">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens35mm" data-comp="left">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens35mm" data-comp="right">OK</span></td></tr>
                <tr><td style="text-align:right;padding:4px 6px;color:var(--text-secondary)">40mm</td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens40mm" data-comp="center">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens40mm" data-comp="left">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens40mm" data-comp="right">OK</span></td></tr>
                <tr><td style="text-align:right;padding:4px 6px;color:var(--text-secondary)">45mm</td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens45mm" data-comp="center">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens45mm" data-comp="left">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens45mm" data-comp="right">OK</span></td></tr>
                <tr><td style="text-align:right;padding:4px 6px;color:var(--text-secondary)">50mm</td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens50mm" data-comp="center">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens50mm" data-comp="left">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens50mm" data-comp="right">OK</span></td></tr>
                <tr><td style="text-align:right;padding:4px 6px;color:var(--text-secondary)">55mm</td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens55mm" data-comp="center">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens55mm" data-comp="left">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens55mm" data-comp="right">OK</span></td></tr>
                <tr><td style="text-align:right;padding:4px 6px;color:var(--text-secondary)">60mm</td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens60mm" data-comp="center">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens60mm" data-comp="left">OK</span></td><td style="text-align:center;padding:4px"><span class="mx" data-lens="lens60mm" data-comp="right">OK</span></td></tr>
              </tbody>
            </table>
            <div style="font-size:8pt;color:var(--text-muted);margin-top:6px">
              TC02: 1 product × 7 lens = 7 outputs • TC04: 1 product × 7 lens × N segments
            </div>
          </div>
        </div>
      </div>

      <!-- Settings: Batch (TC03, TC04) -->
      <div class="panel" data-tc-show="tc03 tc04" style="display:none">
        <div class="panel-header" style="color: var(--tc03)">📦 Batch — ความยาวช่วงและการจับคู่ Background/Audio</div>
        <div class="panel-body">
          <div class="field-grid">
            <div class="field">
              <label>⏱️ Segment (s)</label>
              <input type="number" id="f-segment_duration" value="10" min="0.5" max="600" step="0.5" />
              <div class="help">ความยาว segment ต่อ 1 output (วินาที)
• default = 10s
• คลิป 10 นาที ÷ 10s = 60 outputs
• คลิป 10 นาที ÷ 30s = 20 outputs
• คลิป 10 นาที ÷ 60s = 10 outputs</div>
            </div>
            <div class="field">
              <label>🔀 Match mode</label>
              <select id="f-match_mode" style="width:100%">
                <option value="no_repeat" selected>no_repeat — ไม่ซ้ำ (default)</option>
                <option value="random">random — สุ่ม</option>
                <option value="sequential">sequential — ตามลำดับ</option>
                <option value="shuffle_once">shuffle_once — สับครั้งเดียว</option>
              </select>
              <div class="help">วิธีจับคู่ Background/Audio กับแต่ละ segment</div>
            </div>
            <div class="field full">
              <label>🎲 Run seed (0 = auto)</label>
              <input type="number" id="f-batch-seed" value="0" min="0" max="999999" step="1" />
              <div class="help">0 = สร้าง seed ใหม่อัตโนมัติ; 1-999999 = ทำซ้ำการจับคู่
Product/Background/Audio ตาม pipeline นั้น</div>
            </div>
          </div>
        </div>
      </div>

      <!-- TC05 hint: which dropzones to use -->
      <div class="panel" data-tc-show="tc05" style="display:none">
        <div class="panel-header" style="color: var(--tc05)">🎞️ TC05 — Reframe Only</div>
        <div class="panel-body">
          <div style="font-size:9pt;line-height:1.6;color:var(--text-secondary)">
            <b>ใช้ Dropzone ไหน:</b><br>
            • <b>🎬 Product</b> = source video (ไม่ต้องมีจอเขียว — TC05 เป็น reframe ล้วน ไม่มี chroma)<br>
            • <b>🌄 Background / 🎵 Audio / 🖼️ Cover</b> = ไม่ใช้ (ปล่อยว่างได้)<br><br>
            <b>Output:</b> 21 mp4 ต่อ 1 source (7 lens × 3 comp) — ใช้ settings Reframe ด้านบน (max_parallel จำกัด 1-3)
          </div>
        </div>
      </div>

      <!-- TC06 hint: which dropzones to use -->
      <div class="panel" data-tc-show="tc06" style="display:none">
        <div class="panel-header" style="color: var(--tc06)">🎵 TC06 — Chroma + Audio Master</div>
        <div class="panel-body">
          <div style="font-size:9pt;line-height:1.6;color:var(--text-secondary)">
            <b>ใช้ Dropzone ไหน:</b><br>
            • <b>🎬 Product</b> = หลายวิดีโอจอเขียว (1+ ไฟล์ — แต่ละ product จะถูก chroma แยก)<br>
            • <b>🌄 Background</b> = background pool (1+ ไฟล์)<br>
            • <b>🎵 Audio</b> = <b>master audio</b> (1 ไฟล์ — ใช้ audio นี้ต่อกับทุก output)<br>
            • <b>🖼️ Cover</b> = ไม่ใช้ (ปล่อยว่างได้)<br><br>
            <b>Output:</b> N products × audio master = N mp4 (campaign / batch multi-product ใช้ audio เพลงเดียวกัน)
          </div>
        </div>
      </div>

      <!-- Count + Actions -->
      <div class="count-line" id="countLine">📊 0 products → 0 outputs</div>
      <div class="action-bar">
        <button class="btn btn-primary" id="renderBtn" disabled>▶ Render</button>
        <button class="btn btn-secondary" id="newBtn" title="เริ่ม render ใหม่ — ล้างไฟล์ + log + progress (อยู่หน้าเดิม)"><span style="font-size:11pt;line-height:1">🔄</span><span>เริ่มใหม่</span></button>
        <button class="btn btn-secondary" id="stopBtn" disabled>⏸ Stop</button>
        <button class="btn btn-secondary" id="previewBtn" disabled>👁 Preview (Ctrl+P)</button>
        <button class="btn btn-secondary" id="openOutBtn">📁 เปิด Output (Ctrl+O)</button>
        <button class="btn btn-muted" id="clearLogBtn">🗑 Clear log</button>
      </div>

      <!-- Progress -->
      <div class="progress-row">
        <div class="progress-bar"><div class="fill" id="progFill"></div></div>
        <div class="progress-info" id="progInfo">⏸ Idle</div>
      </div>

      <!-- Toast stack (top-right notifications) -->
      <div class="toast-stack" id="toastStack"></div>

      <!-- Log -->
      <div class="log-frame">
        <div class="log-header">
          <span>📋 Log</span>
          <button class="btn-muted btn" id="clearLogBtn" style="padding:3px 8px;font-size:9pt;">Clear</button>
        </div>
        <div class="log-body" id="logBody"></div>
      </div>

    </div>
  </div>
  <!-- ================================================================
       TAB PANE: greenstats realtime
       ================================================================ -->
  <div class="tab-pane" data-pane="stats" style="display:none">
    <div class="scrollable">
      <div class="page-header" style="margin-bottom: 16px;">
        <h2 style="margin:0;display:flex;align-items:center;gap:10px;">
          <span class="dot" style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#6fcf97;box-shadow:0 0 12px #6fcf97;animation:v3-pulse 1.6s infinite"></span>
          greenstats.sj88ai.com — Realtime
        </h2>
        <div style="color:var(--muted);font-size:11px;font-family:monospace;margin-top:6px;">
          <span id="gs-conn" class="conn">● polling every 5s</span>
          &nbsp;·&nbsp;
          <span id="gs-lastAt">—</span>
        </div>
      </div>

      <section class="cards" style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px;">
        <div class="card"><div class="label">Total Runs</div><div class="value" id="gs-kpi-runs">—</div><div class="delta" id="gs-kpi-runs-d">+0 since start</div></div>
        <div class="card"><div class="label">Successful</div><div class="value" id="gs-kpi-ok">—</div><div class="delta" id="gs-kpi-ok-d">+0 since start</div></div>
        <div class="card"><div class="label">Failed</div><div class="value" id="gs-kpi-fail">—</div><div class="delta" id="gs-kpi-fail-d">+0 since start</div></div>
        <div class="card"><div class="label">Success Rate</div><div class="value" id="gs-kpi-rate">—</div><div class="delta" id="gs-kpi-rate-d">— since start</div></div>
      </section>

      <section style="background:var(--bg-card);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:14px;">
        <h3 style="margin:0 0 12px;font-size:13px;">Totals over time <span style="color:var(--muted);font-size:11px;font-weight:400;float:right">runs + successful + success rate %</span></h3>
        <div style="position:relative;height:240px"><canvas id="gs-ch-totals"></canvas></div>
      </section>

      <section style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
        <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:10px;padding:14px;">
          <h3 style="margin:0 0 12px;font-size:13px;">Runs per TC <span style="color:var(--muted);font-size:11px;font-weight:400;float:right">stacked</span></h3>
          <div style="position:relative;height:220px"><canvas id="gs-ch-tc"></canvas></div>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:10px;padding:14px;">
          <h3 style="margin:0 0 12px;font-size:13px;">Success rate per TC <span style="color:var(--muted);font-size:11px;font-weight:400;float:right">%</span></h3>
          <div style="position:relative;height:220px"><canvas id="gs-ch-rate"></canvas></div>
        </div>
      </section>

      <section style="background:var(--bg-card);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:14px;">
        <h3 style="margin:0 0 12px;font-size:13px;">Failure breakdown (local) <span style="color:var(--muted);font-size:11px;font-weight:400;float:right" id="gs-fb-meta">aggregating from <span id="gs-fb-count">0</span> recent jobs</span></h3>
        <div style="display:grid;grid-template-columns:280px 1fr;gap:18px;align-items:center;">
          <div style="position:relative;height:240px"><canvas id="gs-ch-failures"></canvas></div>
          <table style="width:100%;border-collapse:collapse;font-size:12px;">
            <thead>
              <tr style="color:var(--muted);font-size:10px;text-transform:uppercase;">
                <th style="text-align:left;padding:6px 8px;border-bottom:1px solid var(--line)">Code</th>
                <th style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)">Count</th>
                <th style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)">%</th>
                <th style="text-align:left;padding:6px 8px;border-bottom:1px solid var(--line)">Bar</th>
              </tr>
            </thead>
            <tbody id="gs-fb-tbody"></tbody>
          </table>
        </div>
      </section>

      <section style="background:var(--bg-card);border:1px solid var(--line);border-radius:10px;padding:14px;">
        <h3 style="margin:0 0 12px;font-size:13px;">Per-TC breakdown <span style="color:var(--muted);font-size:11px;font-weight:400;float:right" id="gs-lastUpdate2">—</span></h3>
        <table style="width:100%;border-collapse:collapse;font-size:12px;">
          <thead>
            <tr style="color:var(--muted);font-size:10px;text-transform:uppercase;">
              <th style="text-align:left;padding:6px 8px;border-bottom:1px solid var(--line)">TC</th>
              <th style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)">Inputs</th>
              <th style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)">Outputs</th>
              <th style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)">Runs</th>
              <th style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)">Successful</th>
              <th style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)">Failed</th>
              <th style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)">Rate</th>
              <th style="text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)">Δ Runs (5m)</th>
            </tr>
          </thead>
          <tbody id="gs-tbody"></tbody>
        </table>
      </section>
    </div>
  </div>
</main>

<!-- ================================================================
     STATUS BAR (26px, dark card)
     ================================================================ -->
<footer class="status-bar">
  <div class="left">
    <span id="ffmpegLabel">ffmpeg: …</span>
    <span class="sep">•</span>
    <span>V1.1.1</span>
    <span class="sep">•</span>
    <span id="debugLabel">DebugLog: OFF</span>
  </div>
  <div class="right">
    <span class="busy-idle" id="busyLabel">⏸ Idle</span>
  </div>
</footer>

<script type="13db993d3a7f54f9fd842fb2-module">
/* ================================================================
   Client logic — drop zones, settings, render flow, status
   ES6 module imports for shared helpers (P28).
   ================================================================ */
import { $, escapeHtml, formatSize } from "/js/format.js";
import { toast } from "/js/toast.js";

const AUTH_TOKEN_KEY = "green_cutdee_api_token_v1";
function storedAuthToken() {
  // Keep the bearer key out of persistent browser storage. The API exchange
  // below creates the short-lived HttpOnly session cookie used by the UI.
  return "";
}
function authFetchHeaders(extra = {}) {
  const headers = new Headers(extra);
  const token = storedAuthToken();
  if (token) headers.set("Authorization", `Bearer ${token}`);
  return headers;
}
async function authFetch(url, options = {}) {
  const response = await fetch(url, { ...options, headers: authFetchHeaders(options.headers || {}) });
  if (response.status === 401) {
    const error = new Error("401 authentication required");
    error.status = 401;
    throw error;
  }
  return response;
}
async function establishAuthSession(token) {
  const value = String(token || "").trim();
  if (!value) throw new Error("ต้องใส่ API token");
  const response = await fetch("/api/auth/session", {
    method: "POST",
    headers: { Authorization: `Bearer ${value}` },
    credentials: "same-origin",
  });
  if (!response.ok) {
    throw new Error(`authentication failed: ${response.status}`);
  }
  return response.json();
}
function clearAuthSession() {
  try { localStorage.removeItem(AUTH_TOKEN_KEY); } catch {}
}
window.greenCutdeeAuth = { establish: establishAuthSession, clear: clearAuthSession, token: storedAuthToken };
clearAuthSession();

const state = {
  files: { cover: [], product: [], bg: [], audio: [] },
  jobId: null,
  pollTimer: null,
  busy: false,
  activeTab: "tc01",  // current tab (tc01 | tc02 | tc03 | tc04 | tc05 | tc06)
};

const logEl   = $("logBody");
const progFill= $("progFill");
const progInfo= $("progInfo");
const busyLbl = $("busyLabel");
const dot     = $("statusDot");
const renderBtn  = $("renderBtn");
const stopBtn    = $("stopBtn");
const previewBtn = $("previewBtn");

/* ----- log ----- */
function log(msg, level = "info") {
  const line = document.createElement("div");
  line.className = "line " + level;
  const ts = new Date().toLocaleTimeString("en-GB", { hour12: false });
  line.textContent = `[${ts}] ${msg}`;
  logEl.appendChild(line);
  logEl.scrollTop = logEl.scrollHeight;
  while (logEl.childNodes.length > 400) logEl.removeChild(logEl.firstChild);
}
function setBusy(b, label) {
  state.busy = b;
  if (b) {
    dot.classList.add("busy"); dot.classList.remove("error");
    busyLbl.textContent = "🔄 " + (label || "Rendering") + "...";
    busyLbl.className = "busy-busy";
  } else {
    dot.classList.remove("busy");
    busyLbl.textContent = "⏸ Idle";
    busyLbl.className = "busy-idle";
  }
  renderBtn.disabled = b || !canRender();
  stopBtn.disabled = !b;
}

/* ----- drop zones ----- */
document.querySelectorAll(".dz").forEach((zone) => {
  const key = zone.dataset.zone;
  const fileInput = zone.querySelector('input[type=file]');
  const emptyEl   = zone.querySelector(".dz-empty");
  const filesEl   = zone.querySelector(".dz-files");

  emptyEl.addEventListener("click", () => fileInput.click());
  fileInput.addEventListener("change", () => {
    addFiles(key, Array.from(fileInput.files));
    fileInput.value = "";
  });

  ["dragenter","dragover"].forEach(ev => {
    zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.add("over"); });
  });
  ["dragleave","drop"].forEach(ev => {
    zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.remove("over"); });
  });
  zone.addEventListener("drop", e => {
    const files = Array.from(e.dataTransfer.files || []);
    if (files.length) addFiles(key, files);
  });

  // Ctrl+V paste path
  zone.addEventListener("paste", e => {
    const txt = (e.clipboardData || window.clipboardData).getData("text");
    if (txt && /\.(mp4|mov|mkv|avi|m4v|webm|png|jpg|jpeg|webp|bmp|mp3|wav|m4a|aac|flac|ogg)$/i.test(txt.trim())) {
      e.preventDefault();
      addFiles(key, [new File([new Blob()], txt.trim().split(/[\\/]/).pop(), { type: "video/mp4" })]);
    }
  });

  function addFiles(k, fs) {
    state.files[k] = state.files[k].concat(fs);
    renderZone(k);
    updateCount();
    renderBtn.disabled = !canRender();
    previewBtn.disabled = !canPreview();
  }
  function renderZone(k) {
    const z = document.querySelector(`.dz[data-zone="${k}"]`);
    const fEl = z.querySelector(".dz-files");
    const countBadge = z.querySelector(".dz-count");
    fEl.innerHTML = "";
    if (countBadge) countBadge.textContent = state.files[k].length;
    if (state.files[k].length === 0) { z.classList.remove("filled"); return; }
    z.classList.add("filled");
    state.files[k].forEach((f, i) => {
      const row = document.createElement("div");
      row.className = "file-row";
      // Detect file type from extension
      const ext = (f.name.split(".").pop() || "?").toLowerCase();
      const typeMap = { mp4: "mp4", mov: "mov", mkv: "mkv", avi: "avi", m4v: "m4v", webm: "webm", png: "img", jpg: "img", jpeg: "img", webp: "img", mp3: "audio", wav: "audio", m4a: "audio", aac: "audio", flac: "audio", ogg: "audio" };
      const ftype = typeMap[ext] || ext;
      row.innerHTML = `<span>📎</span><span class="fname">${escapeHtml(f.name)}</span><span class="ftype">${ftype}</span><span style="color:var(--text-muted);font-size:8pt">${formatSize(f.size)}</span><span class="del" title="ลบ">×</span>`;
      row.querySelector(".del").onclick = () => {
        state.files[k].splice(i, 1); renderZone(k); updateCount();
        renderBtn.disabled = !canRender(); previewBtn.disabled = !canPreview();
      };
      fEl.appendChild(row);
    });
  }
});

function canRender() {
  const tc = state.activeTab;
  if (tc === "tc05") return state.files.product.length > 0;            // sources only
  if (tc === "tc06") return state.files.product.length > 0 && state.files.bg.length > 0 && state.files.audio.length > 0;
  return state.files.product.length > 0 && state.files.bg.length > 0;  // TC01-04
}
function canPreview() { return canRender(); }

/* ----- read settings ----- */
function readSettings() {
  const s = {
    key_color: $("f-key_color").value,
    similarity: parseFloat($("f-similarity").value),
    blend:     parseFloat($("f-blend").value),
    despill:   parseFloat($("f-despill").value),
    width:     parseInt($("f-width").value, 10),
    height:    parseInt($("f-height").value, 10),
    fps:       parseInt($("f-fps").value, 10),
    bitrate:   $("f-bitrate").value,
    encoder:   $("f-encoder").value,
    preset:    $("f-preset").value,
    chroma_downscale: parseInt($("f-chroma-downscale")?.value || "0", 10),
  };
  // TC01: matching seed
  if ($("f-seed")) s.seed_tc01 = parseInt($("f-seed").value, 10);
  // TC02 / TC04: reframe
  if ($("f-use_center"))  s.use_center  = $("f-use_center").value === "true";
  if ($("f-use_left"))    s.use_left    = $("f-use_left").value === "true";
  if ($("f-use_right"))   s.use_right   = $("f-use_right").value === "true";
  if ($("f-max_parallel")) s.max_parallel = parseInt($("f-max_parallel").value, 10);
  if ($("f-reframe_mode")) s.reframe_mode = $("f-reframe_mode").value;
  // TC03 / TC04: batch
  if ($("f-segment_duration")) s.segment_duration = parseFloat($("f-segment_duration").value);
  if ($("f-match_mode"))       s.match_mode = $("f-match_mode").value;
  if ($("f-batch-seed"))       s.seed = parseInt($("f-batch-seed").value, 10);
  return s;
}

/* ----- update count line based on TC + products ----- */
function updateCount() {
  const np = state.files.product.length;
  const nb = state.files.bg.length;
  const el = $("countLine");
  const tc = state.activeTab;
  let outputs = 0;
  let breakdown = "";
  if (np > 0 && nb > 0) {
    if (tc === "tc01") {
      outputs = np;
      breakdown = `${np} product × 1 chroma = ${outputs} output`;
    } else if (tc === "tc02") {
      // 7 lenses × N compositions
      const nC = (($("f-use_center")?.value === "true") ? 1 : 0)
               + (($("f-use_left")?.value   === "true") ? 1 : 0)
               + (($("f-use_right")?.value  === "true") ? 1 : 0);
      outputs = np * 7 * Math.max(nC, 1);
      breakdown = `${np} × 7 lens × ${nC} comp = ${outputs}`;
    } else if (tc === "tc03" || tc === "tc04") {
      // Need segment_duration; products' duration unknown client-side
      const seg = parseFloat($("f-segment_duration")?.value || 10);
      // Estimate from typical 10s product = ceil(10/seg)
      const nSeg = Math.max(1, Math.ceil(10 / seg));
      if (tc === "tc03") {
        outputs = np * nSeg;
        breakdown = `${np} product × ${nSeg} segments = ${outputs} (est. 10s ÷ ${seg}s)`;
      } else {
        // TC04: 7 × N comp × N seg
        const nC = (($("f-use_center")?.value === "true") ? 1 : 0)
                 + (($("f-use_left")?.value   === "true") ? 1 : 0)
                 + (($("f-use_right")?.value  === "true") ? 1 : 0);
        outputs = np * 7 * Math.max(nC, 1) * nSeg;
        breakdown = `${np} × 7 lens × ${nC} comp × ${nSeg} seg = ${outputs}`;
      }
    } else {
      outputs = np;
    }
  }
  // TC05: reframe only (sources → 7 lens × N comp)
  if (tc === "tc05" && np > 0) {
    const nC = (($("f-use_center")?.value === "true") ? 1 : 0)
             + (($("f-use_left")?.value   === "true") ? 1 : 0)
             + (($("f-use_right")?.value  === "true") ? 1 : 0);
    outputs = np * 7 * Math.max(nC, 1);
    breakdown = `${np} source × 7 lens × ${nC} comp = ${outputs} (reframe only, no chroma)`;
  }
  // TC06: multi-product + audio master (product count × master audio)
  if (tc === "tc06" && np > 0) {
    const na = state.files.audio.length;
    outputs = np;
    breakdown = `${np} product(s) × ${na || 0} master audio → ${outputs} final output(s)`;
  }
  el.innerHTML = `<b class="acc">${np}</b> product(s) → <b class="acc">${outputs}</b> output(s) <span class="breakdown">${breakdown ? '· ' + breakdown : ''}</span>`;
}

/* ----- update 7x3 matrix cells based on use_center/left/right ----- */
function updateMatrix() {
  const onC = $("f-use_center")?.value === "true";
  const onL = $("f-use_left")?.value   === "true";
  const onR = $("f-use_right")?.value  === "true";
  document.querySelectorAll(".mx").forEach(cell => {
    const comp = cell.dataset.comp;
    const on = (comp === "center" && onC) || (comp === "left" && onL) || (comp === "right" && onR);
    cell.textContent = on ? "OK" : "—";
    cell.classList.toggle("disabled", !on);
  });
  // count enabled outputs
  const nC = (onC?1:0) + (onL?1:0) + (onR?1:0);
  const matrixCount = $("matrixCount");
  if (matrixCount) matrixCount.textContent = (7 * Math.max(nC, 1));
}

/* ----- render flow ----- */
renderBtn.addEventListener("click", async () => {
  if (!canRender()) return;
  // TC05/06 are now supported (v1.0.0.22+)
  const tc = state.activeTab;
  setBusy(true, "Rendering " + tc.toUpperCase());
  renderBtn.disabled = true;
  stopBtn.disabled = false;
  log(`→ submit ${tc.toUpperCase()} job`, "info");
  // Reset pipeline badges for multi-step TCs
  resetPipelineBadges();
  setStepStatus(1, "running");
  // Toast — confirm to user that render started
  toast(`🚀 เริ่ม ${tc.toUpperCase()} render แล้วนะ`, `Job กำลังทำงาน — โปรดรอสักครู่…`, "info", 2500);
  try {
    // Client-side validation (avoid 400 round-trip)
    const w = parseInt($("f-width").value);
    const h = parseInt($("f-height").value);
    if (w < 64 || w > 4096 || h < 64 || h > 4096) {
      throw new Error(`width/height ต้องอยู่ใน 64-4096 (ได้ ${w}×${h})`);
    }
    if (w % 2 !== 0 || h % 2 !== 0) {
      throw new Error(`width/height ต้องเป็นเลขคู่ (${w}×${h})`);
    }
    if (!/^\d+[kKmM]$/.test($("f-bitrate").value)) {
      throw new Error(`bitrate ต้องลงท้ายด้วย k/M (เช่น 6000k, 12M) — ได้ "${$("f-bitrate").value}"`);
    }
    if (tc === "tc03" || tc === "tc04") {
      const seg = parseFloat($("f-segment_duration").value);
      if (seg < 0.5 || seg > 600) {
        throw new Error(`segment_duration ต้องอยู่ใน 0.5-600s (ได้ ${seg})`);
      }
    }
    if (tc === "tc05") {
      const mp = parseInt($("f-max_parallel").value);
      if (mp < 1 || mp > 3) {
        throw new Error(`TC05 max_parallel ต้องอยู่ใน 1-3 (ได้ ${mp}) — TC05 จำกัด workers`);
      }
    }
    // Disk pre-check (5GB free minimum)
    try {
      const h = await authFetch("/api/health").then(r => r.json());
      if (h.disk_free_gb < 5) {
        const ok = confirm(`⚠️ เหลือพื้นที่ disk แค่ ${h.disk_free_gb.toFixed(1)} GB (แนะนำ ≥ 5 GB)\n\nยืนยัน render ต่อ?`);
        if (!ok) {
          setBusy(false);
          renderBtn.disabled = !canRender();
          return;
        }
      }
    } catch {}

    // Render time estimate (heuristic)
    try {
      const np = state.files.product.length;
      if (np > 0) {
        const totalSize = state.files.product.reduce((s, f) => s + (f.size || 0), 0);
        // Rough estimate: ~5MB/s throughput for 1080p@30fps ultrafast CPU
        const fpsFactor = (parseInt($("f-fps").value) / 30) * (parseInt($("f-width").value) * parseInt($("f-height").value) / (1080*1920));
        const presetFactor = { ultrafast: 0.3, superfast: 0.5, veryfast: 0.7, faster: 0.9, fast: 1, medium: 1.5, slow: 2.5, slower: 4, veryslow: 6 }[$("f-preset").value] || 1;
        const baseTime = (totalSize / 5_000_000) * presetFactor * fpsFactor;
        let outCount = 1;
        if (tc === "tc02") outCount = 7 * (($("f-use_center")?.value === "true") + ($("f-use_left")?.value === "true") + ($("f-use_right")?.value === "true"));
        else if (tc === "tc03") outCount = Math.ceil(10 / parseFloat($("f-segment_duration")?.value || 10));
        else if (tc === "tc04") outCount = 7 * (($("f-use_center")?.value === "true") + ($("f-use_left")?.value === "true") + ($("f-use_right")?.value === "true")) * Math.ceil(10 / parseFloat($("f-segment_duration")?.value || 10));
        else if (tc === "tc05") outCount = 7 * (($("f-use_center")?.value === "true") + ($("f-use_left")?.value === "true") + ($("f-use_right")?.value === "true"));
        const estMin = Math.max(0.5, (baseTime * outCount) / 60);
        toast(`⏱️ Est: ${estMin.toFixed(1)} นาที (${outCount} outputs × ${presetFactor}x preset)`, "ประมาณการ — ขึ้นกับ GPU/CPU", "info", 4000);
      }
    } catch {}

    const fd = new FormData();
    // TC-specific field mapping (TC05/06 use different param names)
    if (tc === "tc05") {
      // TC05 = Reframe Only: product zone → sources
      state.files.product.forEach(f => fd.append("sources", f));
    } else if (tc === "tc06") {
      // TC06 = Multi-product chroma + audio master
      state.files.product.forEach(f => fd.append("products", f));
      state.files.bg.forEach(f => fd.append("backgrounds", f));
      state.files.audio.forEach(f => fd.append("audios", f));
    } else {
      // TC01-04: standard mapping
      state.files.product.forEach(f => fd.append("product", f));
      state.files.bg.forEach(f => fd.append("background", f));
      state.files.audio.forEach(f => fd.append("audio", f));
      state.files.cover.forEach(f => fd.append("cover", f));
    }
    const s = readSettings();
    Object.entries(s).forEach(([k,v]) => fd.append(k, v));

    const res = await authFetch("/api/render/" + tc, { method: "POST", body: fd });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.detail || res.statusText);
    }
    const data = await res.json();
    state.jobId = data.job_id;
    log(`✓ ${tc.toUpperCase()} job ${data.job_id} queued`, "ok");
    pollJob();
  } catch (e) {
    log("✗ submit failed: " + e.message, "err");
    toast("❌ Submit ล้มเหลว", e.message, "error", 5000);
    setBusy(false);
    renderBtn.disabled = !canRender();
  }
});

stopBtn.addEventListener("click", async () => {
  if (!state.jobId) return;
  log("→ cancel " + state.jobId, "warn");
  try { await authFetch("/api/job/" + state.jobId + "/cancel", { method: "POST" }); } catch {}
});

async function pollJob() {
  if (!state.jobId) return;
  // Try WebSocket first; fall back to HTTP polling on error
  if (state.wsEnabled !== false) {
    const ok = await tryWebSocket();
    if (ok) return;  // WS handler takes over
    state.wsEnabled = false;
    log("⚠️ WebSocket unavailable, using HTTP polling (1s interval)", "warn");
  }
  // HTTP polling fallback
  try {
    const res = await authFetch("/api/job/" + state.jobId);
    if (!res.ok) throw new Error("poll " + res.status);
    const d = await res.json();
    if (d.log) d.log.forEach(l => log(l.msg, l.level || "info"));
    applyJobSnapshot(d);
    if (d.status === "done" || d.status === "failed" || d.status === "cancelled") {
      finalizeJob(d);
      return;
    }
    setTimeout(pollJob, 1000);
  } catch (e) {
    log("✗ poll error: " + e.message, "err");
    setTimeout(pollJob, 2000);
  }
}

// Try WebSocket; resolves true on success, false on failure
async function tryWebSocket() {
  if (!state.jobId) return false;
  const proto = location.protocol === "https:" ? "wss:" : "ws:";
  const url = `${proto}//${location.host}/ws/job/${state.jobId}`;
  return new Promise((resolve) => {
    let ws;
    try { ws = new WebSocket(url); } catch (e) { resolve(false); return; }
    let opened = false;
    const timeout = setTimeout(() => { if (!opened) { try { ws.close(); } catch{}; resolve(false); } }, 3000);
    ws.onopen = () => {
      opened = true; clearTimeout(timeout);
      log("🔌 WebSocket connected — real-time updates", "info");
      resolve(true);
      ws.onmessage = (e) => {
        try {
          const d = JSON.parse(e.data);
          if (d.type === "update") {
            applyJobSnapshot(d);
            if (d.log_delta && d.log_delta.length) d.log_delta.forEach(l => log(l, "info"));
            if (d.status === "done" || d.status === "failed" || d.status === "cancelled") {
              finalizeJob(d);
              try { ws.close(); } catch{}
            }
          } else if (d.type === "closed") {
            try { ws.close(); } catch{}
          } else if (d.type === "error") {
            log("✗ WS error: " + d.detail, "err");
            try { ws.close(); } catch{}
          }
        } catch (err) { log("✗ WS parse error: " + err.message, "err"); }
      };
      ws.onerror = () => { /* ignore */ };
      ws.onclose = () => {
        if (state.jobId) { log("🔌 WebSocket closed, HTTP polling…", "warn"); setTimeout(pollJob, 1000); }
      };
    };
    ws.onerror = () => { clearTimeout(timeout); resolve(false); };
  });
}

// Apply a job snapshot to UI (shared between HTTP poll and WS)
function applyJobSnapshot(d) {
  if (!d) return;
  if (typeof d.progress_pct === "number") {
    progFill.style.width = d.progress_pct.toFixed(0) + "%";
  }
  let infoParts = [];
  if (d.current_stage) infoParts.push(d.current_stage);
  if (d.encoder_used) {
    const encLabel = d.encoder_used.replace("h264_", "").replace("hevc_", "HEVC-");
    infoParts.push(`🎬 ${encLabel}`);
  }
  if (typeof d.progress_pct === "number") infoParts.push(d.progress_pct.toFixed(0) + "%");
  if (d.progress_info) infoParts.push(d.progress_info);
  progInfo.textContent = infoParts.join("  •  ") || "running…";
  if (d.encoder_used) {
    const gpuBadge = $("gpuBadge");
    if (gpuBadge) {
      const isHW = d.encoder_used !== "libx264";
      gpuBadge.textContent = isHW ? `⚡ ${d.encoder_used}` : "🖥 CPU";
      gpuBadge.style.background = isHW ? "rgba(76,175,80,0.2)" : "rgba(76,175,80,0.08)";
      gpuBadge.style.borderColor = isHW ? "var(--tc01)" : "var(--border)";
      gpuBadge.title = isHW ? `Hardware encoder: ${d.encoder_used}` : "CPU encoder: libx264";
    }
  }
  if (d.current_step) {
    const [stepName, statusText] = d.current_step.split("|");
    const m = stepName.match(/^step(\d+)/);
    if (m) {
      const stepNum = parseInt(m[1]);
      for (let i = 1; i < stepNum; i++) setStepStatus(i, "done");
      setStepStatus(stepNum, "running");
    }
  }
}

// Finalize a job (called when status reaches terminal)
function finalizeJob(d) {
  if (!d) return;
  if (d.status === "done") {
    const done_job_id = state.jobId;
    log("✓ render done → " + d.output_path, "ok");
    toast("✅ " + state.activeTab.toUpperCase() + " Render เสร็จแล้ว!", "กำลัง download ไฟล์…", "success", 4000);
    setBusy(false);
    state.jobId = null;
    const totalSteps = (TC_META[state.activeTab]?.steps || []).length;
    for (let i = 1; i <= totalSteps; i++) setStepStatus(i, "done");
    showDownload(d.output_path, done_job_id);
    showThumbnailGallery(done_job_id);
  } else if (d.status === "failed" || d.status === "cancelled") {
    log("✗ " + d.status + ": " + (d.error || ""), "err");
    toast("❌ " + d.status, d.error || "Render ล้มเหลว", "error", 5000);
    setBusy(false);
    state.jobId = null;
    const totalSteps = (TC_META[state.activeTab]?.steps || []).length;
    for (let i = 1; i <= totalSteps; i++) {
      const step = document.querySelector(`.pipeline-step[data-step="${i}"]`);
      if (step && step.classList.contains("running")) setStepStatus(i, "error");
    }
  }
}

function showDownload(path, job_id) {
  if (!path) return;
  const jid = job_id || state.jobId;
  if (!jid) return;
  // Trigger single-file download
  const singleUrl = "/api/job/" + jid + "/output";
  const a = document.createElement("a");
  a.href = singleUrl; a.download = path.split("/").pop();
  document.body.appendChild(a); a.click(); a.remove();
  log("⤓ downloading " + a.download, "ok");
  // For multi-output TCs (TC02-06), also offer ZIP
  const tc = state.activeTab;
  if (["tc02", "tc03", "tc04", "tc05", "tc06"].includes(tc)) {
    setTimeout(() => {
      const zipUrl = "/api/job/" + jid + "/download-all";
      const a2 = document.createElement("a");
      a2.href = zipUrl; a2.download = `sj88_greenscreen_${jid}.zip`;
      document.body.appendChild(a2); a2.click(); a2.remove();
      log("⤓ downloading ZIP (all outputs)", "ok");
      toast("📦 ZIP พร้อม download", "ทุก output รวมใน ZIP 1 ไฟล์", "success", 4000);
    }, 600);
  }
}

// Show thumbnail gallery of all outputs in a modal
async function showThumbnailGallery(jid) {
  try {
    const d = await authFetch("/api/job/" + jid + "/thumbnails").then(r => r.json());
    if (!d.files || d.files.length === 0) return;
    if (d.files.length === 1) return;  // single output — no need for gallery
    let m = $("thumbGallery");
    if (m) m.remove();
    m = document.createElement("div");
    m.id = "thumbGallery";
    m.className = "help-modal-backdrop";
    const fileCards = d.files.map((f, i) => `
      <div class="thumb-card" data-i="${i}" data-url="${f.thumb_url}" data-name="${f.name}">
        <video src="${f.thumb_url}" preload="metadata" muted playsinline></video>
        <div class="thumb-name" title="${f.path}">${f.name.length > 30 ? f.name.slice(0,27)+'…' : f.name}</div>
        <button class="thumb-dl" data-url="/api/job/${jid}/output?file=${encodeURIComponent(f.path)}" data-name="${f.name}">⤓</button>
      </div>
    `).join("");
    m.innerHTML = `
      <div class="help-modal history-modal" style="max-width: 1100px;" onclick="event.stopPropagation()">
        <button class="close-btn" onclick="$('thumbGallery').remove()">✕ ปิด</button>
        <h2>🖼️ Output Gallery (${d.files.length} files)</h2>
        <p style="font-size:10pt;color:var(--text-secondary);">คลิก thumbnail เพื่อดูภาพใหญ่ • ปุ่ม ⤓ เพื่อ download ไฟล์นั้น</p>
        <div class="thumb-grid">${fileCards}</div>
      </div>
    `;
    m.addEventListener("click", () => m.remove());
    document.body.appendChild(m);
    // Wire up: click thumbnail = open in new tab (full image); click ⤓ = download
    m.querySelectorAll(".thumb-card").forEach(card => {
      const preview = card.querySelector("video");
      preview.addEventListener("click", (e) => {
        e.stopPropagation();
        window.open(card.dataset.url, "_blank");
      });
    });
    m.querySelectorAll(".thumb-dl").forEach(btn => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const a = document.createElement("a");
        a.href = btn.dataset.url; a.download = btn.dataset.name;
        document.body.appendChild(a); a.click(); a.remove();
        log("⤓ downloading " + btn.dataset.name, "ok");
      });
    });
  } catch (e) {
    log("⚠️ Thumbnail gallery error: " + e.message, "warn");
  }
}

/* ----- preview (server-side render low-res) ----- */
previewBtn.addEventListener("click", async () => {
  if (!canPreview()) return;
  const tc = state.activeTab;
  if (tc === "tc05" || tc === "tc06") {
    toast("🚧 " + tc.toUpperCase() + " preview", "preview รองรับเฉพาะ TC01-TC04", "warn", 3000);
    return;
  }
  setBusy(true, "Preview");
  log(`→ preview ${tc.toUpperCase()} render (low-res)`, "info");
  try {
    const fd = new FormData();
    state.files.product.slice(0,1).forEach(f => fd.append("product", f));
    state.files.bg.slice(0,1).forEach(f => fd.append("background", f));
    const s = readSettings();
    s.width = 360; s.height = 360; s.fps = 15; s.bitrate = "300k"; s.preset = "ultrafast";
    Object.entries(s).forEach(([k,v]) => fd.append(k, v));
    const res = await authFetch("/api/render/" + tc, { method: "POST", body: fd });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.detail || res.statusText);
    }
    const d = await res.json();
    state.jobId = d.job_id;
    pollJob();
  } catch (e) {
    log("✗ preview failed: " + e.message, "err");
    setBusy(false);
  }
});

/* ----- header buttons ----- */
$("openOutputBtn").addEventListener("click", () => window.open("/outputs/", "_blank"));
$("openOutBtn").addEventListener("click", () => window.open("/outputs/", "_blank"));
$("authBtn").addEventListener("click", async () => {
  const value = prompt("ใส่ API token ของ Green Screen (ต้องขึ้นต้นด้วย cutdee_vdo_):", "");
  if (value === null) return;
  if (!value.trim()) {
    clearAuthSession();
    $("authBtn").textContent = "🔐 API token";
    toast("🔐", "ล้าง API token แล้ว", "info", 2000);
    return;
  }
  try {
    const session = await establishAuthSession(value);
    $("authBtn").textContent = "🔓 Token set";
    toast("✅", `ยืนยันสิทธิ์แล้ว (${session.user})`, "success", 2500);
    await loadGallery(1);
    await refreshHealth();
  } catch (e) {
    $("authBtn").textContent = "🔐 API token";
    toast("❌", e.message, "error", 4000);
  }
});
if (storedAuthToken()) $("authBtn").textContent = "🔓 Token set";
$("themeBtn").addEventListener("click", () => {
  // v1.0: dark only (matches Tk default) — toggle button is decorative
  toast("☀️ Light mode", "coming soon — ตอนนี้ใช้ dark mode (default)", "warn", 2500);
});

/* ----- เริ่มใหม่: clear zones + log + progress + job state ----- */
function startNew() {
  if (state.busy) {
    toast("⚠️ กำลัง render อยู่", "กด Stop ก่อน แล้วค่อยเริ่มใหม่", "warn", 3000);
    return;
  }
  // 1. Clear all files from zones
  Object.keys(state.files).forEach(k => { state.files[k] = []; });
  document.querySelectorAll(".dz").forEach(z => {
    z.classList.remove("filled");
    z.querySelector(".dz-files").innerHTML = "";
  });
  // 2. Clear log
  logEl.innerHTML = "";
  // 3. Reset progress
  progFill.style.width = "0%";
  progInfo.textContent = "⏸ Idle";
  // 3.5. Reset pipeline badges
  resetPipelineBadges();
  // 4. Clear job state
  state.jobId = null;
  if (state.pollTimer) { clearTimeout(state.pollTimer); state.pollTimer = null; }
  // 5. Reset buttons
  renderBtn.disabled = !canRender();
  previewBtn.disabled = !canPreview();
  stopBtn.disabled = true;
  // 6. Update count
  updateCount();
  // 7. Toast
  toast("🔄 เริ่มใหม่!", "ล้างไฟล์ + log + progress แล้ว — พร้อม render รอบใหม่", "success", 2500);
  log("🔄 started new session", "info");
}
$("newBtn").addEventListener("click", startNew);

$("clearLogBtn").addEventListener("click", () => { logEl.innerHTML = ""; toast("🗑 Log cleared", "", "info", 1500); });

/* ----- status dot click = refresh ffmpeg ----- */
$("statusDot").addEventListener("click", refreshHealth);

/* ----- health check on load ----- */
async function refreshHealth() {
  try {
    const r = await authFetch("/api/health");
    const d = await r.json();
    $("ffmpegLabel").textContent = "ffmpeg: ✅ " + (d.ffmpeg_version || "ok");
    $("ffmpegLabel").style.color = "var(--success)";
    dot.classList.remove("error");
  } catch (e) {
    $("ffmpegLabel").textContent = "ffmpeg: ❌ " + e.message;
    $("ffmpegLabel").style.color = "var(--danger)";
    dot.classList.add("error");
  }
}
refreshHealth();

/* ----- tab switcher (TC01-TC06) ----- */
document.querySelectorAll(".tab").forEach(t => {
  t.addEventListener("click", () => {
    if (t.classList.contains("disabled")) {
      log("🚧 " + t.textContent.trim() + " — tab ยังไม่เปิดใช้งาน", "warn");
      return;
    }
    document.querySelectorAll(".tab").forEach(x => x.classList.remove("active"));
    t.classList.add("active");
    // Update active tab state
    state.activeTab = t.dataset.tab;
    // Update header badge
    updateActiveTCBadge();
    // Show the right tab-pane (data-pane matches data-tab)
    // CSS rule: .tab-pane {display:none} .tab-pane.active {display:block}
    // TC01-TC06 all live inside the TC01 pane; only "stats" has its own pane
    document.querySelectorAll(".tab-pane").forEach(pane => {
      const p = pane.dataset.pane;
      const show = (p === state.activeTab) || (p === "tc01" && state.activeTab.startsWith("tc"));
      pane.classList.toggle("active", show);
      pane.style.removeProperty("display");
    });
    // Show/hide TC-specific panels within the active pane
    document.querySelectorAll("[data-tc-show]").forEach(panel => {
      const tcs = panel.dataset.tcShow.split(/\s+/);
      panel.style.display = tcs.includes(state.activeTab) ? "" : "none";
    });
    // Update pipeline badge step names per TC
    updatePipelineBadges();
    // Update matrix
    updateMatrix();
    // Update count
    updateCount();
    // Toast on tab change
    const tcName = {tc01:"TC01 ตัดจอเขียว", tc02:"TC02 ออโต้ซูม 7×3",
                    tc03:"TC03 ตัดจอเขียว + หั่นช่วง",
                    tc04:"TC04 ออโต้ซูม + หั่นช่วง",
                    tc05:"TC05 ออโต้ซูมล้วน",
                    tc06:"TC06 Chroma Audio Master"};
    if (tcName[state.activeTab]) {
      toast("🎯 " + tcName[state.activeTab], "panel + endpoint เปลี่ยนตาม tab", "info", 1800);
    }
  });
});

/* ----- Active TC badge in header ----- */
const TC_META = {
  tc01: { name: "ตัดจอเขียว",      accent: "var(--tc01)", steps: ["Chroma"] },
  tc02: { name: "ออโต้ซูม 7×3",   accent: "var(--tc02)", steps: ["Reframe", "Chroma"] },
  tc03: { name: "ตัดจอเขียว + หั่นช่วง", accent: "var(--tc03)", steps: ["Split", "Chroma"] },
  tc04: { name: "ออโต้ซูม + หั่นช่วง",   accent: "var(--tc04)", steps: ["Reframe", "Split", "Chroma"] },
  tc05: { name: "ออโต้ซูมล้วน",   accent: "var(--tc05)", steps: ["Reframe"] },
  tc06: { name: "Chroma Audio Master", accent: "var(--tc06)", steps: ["Chroma", "Audio Master"] },
};
function updateActiveTCBadge() {
  const meta = TC_META[state.activeTab];
  if (!meta) return;
  const badge = $("activeTCBadge");
  badge.style.setProperty("--tc-accent", meta.accent);
  badge.querySelector(".active-tc-label").textContent = state.activeTab.toUpperCase();
  badge.querySelector(".active-tc-name").textContent = meta.name;
  // Also update the body left-border of pipeline badges + content panels
  const canvas = document.querySelector(".tab-pane.active");
  if (canvas) canvas.style.setProperty("--tc-accent", meta.accent);
  // Update countLine border color
  const cl = $("countLine");
  if (cl) cl.style.setProperty("--tc-accent", meta.accent);
  // Update pipeline-badges border color
  const pb = $("pipelineBadges");
  if (pb) pb.style.setProperty("--tc-accent", meta.accent);
  // Also update the per-TC accent variable
  document.documentElement.style.setProperty("--current-tc", meta.accent);
}

/* ----- Pipeline badges (TC02-04) ----- */
function updatePipelineBadges() {
  // For each pipeline-step, show only the relevant step-name for the active TC
  document.querySelectorAll(".pipeline-step .step-name").forEach(el => {
    el.style.display = (el.dataset.stepName === state.activeTab) ? "" : "none";
  });
  // For step 3 (only TC04), show only when TC04
  document.querySelectorAll('[data-step-only="tc04"]').forEach(el => {
    el.style.display = (state.activeTab === "tc04") ? "" : "none";
  });
  document.querySelectorAll('.pipeline-arrow:nth-of-type(3), .pipeline-arrow:last-of-type').forEach(el => {
    // No third arrow if not TC04
  });
  // Show arrows based on number of steps
  const numSteps = (TC_META[state.activeTab]?.steps || []).length;
  const arrows = document.querySelectorAll('.pipeline-badges .pipeline-arrow');
  arrows.forEach((arr, i) => {
    arr.style.display = (i < numSteps - 1) ? "" : "none";
  });
  // Reset all step statuses
  document.querySelectorAll('.pipeline-step').forEach(s => {
    s.classList.remove("running", "done", "error");
    const status = s.querySelector('.step-status');
    if (status) status.textContent = "⏳ waiting";
  });
}

/* ----- Update pipeline step from server (via progress log) ----- */
function setStepStatus(stepNum, status) {
  // status: "waiting" | "running" | "done" | "error"
  const step = document.querySelector(`.pipeline-step[data-step="${stepNum}"]`);
  if (!step) return;
  step.classList.remove("running", "done", "error");
  if (status !== "waiting") step.classList.add(status);
  const statusEl = step.querySelector('.step-status');
  if (statusEl) {
    const map = { waiting: "⏳ waiting", running: "🔄 running", done: "✅ done", error: "❌ error" };
    statusEl.textContent = map[status] || status;
  }
}
function resetPipelineBadges() {
  for (let i = 1; i <= 3; i++) setStepStatus(i, "waiting");
}

/* ----- keyboard shortcuts (mirrors ui/main_window._bind_shortcuts) ----- */
document.addEventListener("keydown", (e) => {
  if (!(e.ctrlKey || e.metaKey)) return;
  if (e.key === "r" || e.key === "R") { e.preventDefault(); if (!renderBtn.disabled) renderBtn.click(); }
  if (e.key === ".")                   { e.preventDefault(); if (!stopBtn.disabled) stopBtn.click(); }
  if (e.key === "o" || e.key === "O")  { e.preventDefault(); $("openOutBtn").click(); }
  if (e.key === "p" || e.key === "P")  { e.preventDefault(); if (!previewBtn.disabled) previewBtn.click(); }
  if (e.key === "l" || e.key === "L")  { e.preventDefault(); $("clearLogBtn").click(); }
  if (e.key === "n" || e.key === "N")  { e.preventDefault(); startNew(); }
  // Ctrl+1..6 = switch TC01-TC06
  if (e.key >= "1" && e.key <= "6") {
    const idx = parseInt(e.key, 10) - 1;
    const tabs = ["tc01","tc02","tc03","tc04","tc05","tc06"];
    const target = document.querySelector(`.tab[data-tab="${tabs[idx]}"]`);
    if (target && !target.classList.contains("disabled")) {
      e.preventDefault();
      target.click();
    }
  }
});

/* ----- reframe / batch setting change handlers ----- */
["f-use_center","f-use_left","f-use_right"].forEach(id => {
  const el = $(id); if (el) el.addEventListener("change", () => { updateMatrix(); updateCount(); });
});
const segEl = $("f-segment_duration");
if (segEl) segEl.addEventListener("change", updateCount);
const matchEl = $("f-match_mode");
if (matchEl) matchEl.addEventListener("change", updateCount);

// Initial matrix render
updateMatrix();
updateActiveTCBadge();
updatePipelineBadges();

log("✓ SJ88 Green Screen WebApp ready (TC01-TC06 chroma + reframe + batch + audio master)", "ok");
log("  ffmpeg, drop zones, settings, render — same as Tk UI", "info");
log("  ⌨️ Ctrl+R render · Ctrl+. stop · Ctrl+O output · Ctrl+P preview · Ctrl+L log · Ctrl+N เริ่มใหม่ · ? help", "info");

// GPU badge + Disk badge (initial load from /api/health)
function showHelpModal() {
  let m = $("helpModal");
  if (m) m.remove();
  m = document.createElement("div");
  m.id = "helpModal";
  m.className = "help-modal-backdrop";
  m.innerHTML = `
    <div class="help-modal" onclick="event.stopPropagation()">
      <button class="close-btn" onclick="$('helpModal').remove()">✕ ปิด</button>
      <h2>❓ SJ88 Green Screen — Help</h2>
      <h3>⌨️ Keyboard Shortcuts</h3>
      <table>
        <tr><td><kbd>Ctrl+R</kbd></td><td>เริ่ม render</td></tr>
        <tr><td><kbd>Ctrl+.</kbd> หรือ <kbd>Esc</kbd></td><td>หยุด render (cancel)</td></tr>
        <tr><td><kbd>Ctrl+P</kbd></td><td>Preview (low-res render — TC01-04)</td></tr>
        <tr><td><kbd>Ctrl+O</kbd></td><td>เปิด Output folder</td></tr>
        <tr><td><kbd>Ctrl+L</kbd></td><td>Clear log</td></tr>
        <tr><td><kbd>Ctrl+N</kbd></td><td>เริ่ม render ใหม่ (clear files + log)</td></tr>
        <tr><td><kbd>Ctrl+T</kbd></td><td>Toggle Dark/Light theme</td></tr>
        <tr><td><kbd>Ctrl+V</kbd></td><td>วาง file path ใน dropzone (selected)</td></tr>
        <tr><td><kbd>?</kbd> หรือ <kbd>F1</kbd></td><td>Help modal นี้</td></tr>
        <tr><td><kbd>1</kbd>..<kbd>6</kbd></td><td>สลับ tab TC01..TC06</td></tr>
      </table>
      <h3>📦 TC Reference</h3>
      <ul>
        <li><b>TC01</b> ตัดจอเขียว — 1 product → 1 output</li>
        <li><b>TC02</b> ออโต้ซูม 7×3 + chroma — 1 product → 21 outputs (7 lens × 3 comp)</li>
        <li><b>TC03</b> ตัดจอเขียว + หั่นช่วง — 1 product → N segments (default 10s)</li>
        <li><b>TC04</b> ออโต้ซูม + หั่นช่วง + chroma — 1 product → 7×3×N outputs (สูงสุด 630)</li>
        <li><b>TC05</b> ออโต้ซูมล้วน — 1 source → 21 outputs (ไม่มี chroma, max 3 workers)</li>
        <li><b>TC06</b> Chroma + Audio Master — N products × master audio</li>
      </ul>
      <h3>🎬 GPU Encoder</h3>
      <p style="font-size:10pt;color:var(--text-secondary);line-height:1.5">ถ้ามี <b>GPU NVIDIA / Intel / AMD</b> ที่รองรับ h264_nvenc / h264_qsv / h264_amf จะถูก auto-detect และใช้เร็วขึ้น 10-30×. ดูได้ที่มุมขวาบน (⚡/🖥 badge).</p>
    </div>
  `;
  m.addEventListener("click", () => m.remove());
  document.body.appendChild(m);
}
$("helpBtn").addEventListener("click", showHelpModal);
document.addEventListener("keydown", (e) => {
  // "?" key (no modifier) or F1
  if (e.key === "?" || e.key === "F1") {
    e.preventDefault();
    showHelpModal();
  }
});

// Number keys 1-6 → switch tab
document.addEventListener("keydown", (e) => {
  if (e.ctrlKey || e.altKey || e.metaKey) return;
  if (e.key >= "1" && e.key <= "6") {
    const idx = parseInt(e.key) - 1;
    const tabs = document.querySelectorAll(".tab:not(.disabled)");
    if (idx < tabs.length) tabs[idx].click();
  }
});

// === GPU badge + Disk badge (initial load from /api/health) ===
(async () => {
  try {
    const h = await authFetch("/api/health").then(r => r.json());
    const gpuBadge = $("gpuBadge");
    if (gpuBadge) {
      const isHW = h.recommended_encoder && h.recommended_encoder !== "libx264";
      gpuBadge.textContent = isHW ? `⚡ ${h.recommended_encoder}` : "🖥 CPU/libx264";
      gpuBadge.style.background = isHW ? "rgba(76,175,80,0.2)" : "rgba(76,175,80,0.08)";
      gpuBadge.style.borderColor = isHW ? "var(--tc01)" : "var(--border)";
      gpuBadge.style.color = isHW ? "var(--tc01)" : "var(--text-muted)";
      gpuBadge.title = isHW ? `Hardware encoder ready: ${h.recommended_encoder}` : "No GPU detected — using CPU";
    }
    const diskBadge = $("diskBadge");
    if (diskBadge && h.disk_free_gb) {
      const freeGB = h.disk_free_gb.toFixed(0);
      const lowDisk = h.disk_free_gb < 5;
      diskBadge.textContent = `💾 ${freeGB} GB free`;
      diskBadge.style.background = lowDisk ? "rgba(239,68,68,0.2)" : "rgba(76,175,80,0.08)";
      diskBadge.style.borderColor = lowDisk ? "var(--danger)" : "var(--border)";
      diskBadge.style.color = lowDisk ? "var(--danger)" : "var(--text-muted)";
      const ramInfo = Number.isFinite(h.ram_used_pct) && Number.isFinite(h.ram_available_gb)
        ? `\nRAM: ${h.ram_used_pct}% used, ${h.ram_available_gb} GB available`
        : "";
      diskBadge.title = `Disk: ${h.disk_used_pct}% used, ${h.disk_free_gb} GB free${ramInfo}`;
    }
  } catch (e) { /* silent */ }
})();

// === Job History modal (📜 button + Ctrl+H) ===
async function showHistoryModal() {
  let m = $("historyModal");
  if (m) m.remove();
  m = document.createElement("div");
  m.id = "historyModal";
  m.className = "help-modal-backdrop";
  m.innerHTML = `
    <div class="help-modal history-modal" onclick="event.stopPropagation()">
      <button class="close-btn" onclick="$('historyModal').remove()">✕ ปิด</button>
      <h2>📜 ประวัติ Render</h2>
      <div id="historyContent">⏳ กำลังโหลด…</div>
    </div>
  `;
  m.addEventListener("click", () => m.remove());
  document.body.appendChild(m);
  // Fetch
  try {
    const d = await authFetch("/api/jobs/history?limit=30").then(r => r.json());
    const c = $("historyContent");
    if (!d.jobs || d.jobs.length === 0) {
      c.innerHTML = '<p class="preset-empty">ยังไม่มีประวัติ — render อะไรสักอย่างก่อนนะ!</p>';
      return;
    }
    let rows = '<table class="history-table"><thead><tr><th>Status</th><th>TC</th><th>Job ID</th><th>Inputs</th><th>Outputs</th><th>Encoder</th><th>Duration</th><th></th></tr></thead><tbody>';
    for (const j of d.jobs) {
      const statusCls = `status-${j.status}`;
      const tcPill = `<span class="tc-pill tc-pill-${j.tc}">${j.tc.toUpperCase()}</span>`;
      const inputs = (j.input_files || []).slice(0, 2).map(f => f.length > 25 ? f.slice(0,22)+"…" : f).join(", ") || "—";
      const outN = j.outputs_total > 0 ? `${j.outputs_count}/${j.outputs_total}` : (j.status === "done" ? "1" : "—");
      const enc = j.encoder_used ? j.encoder_used.replace("h264_", "").replace("hevc_", "HEVC-") : "—";
      let dur = "—";
      if (j.started_at && j.ended_at) {
        const sec = (j.ended_at - j.started_at).toFixed(0);
        dur = sec < 60 ? `${sec}s` : `${(sec/60).toFixed(1)}m`;
      } else if (j.started_at) {
        dur = "⏳ running";
      }
      const actions = j.status === "done"
        ? `<button class="header-btn" style="padding:3px 8px;font-size:9pt;" onclick="event.stopPropagation(); window.location='/api/job/${j.job_id}/output';">⤓</button>
           <button class="header-btn" style="padding:3px 8px;font-size:9pt;" onclick="event.stopPropagation(); window.location='/api/job/${j.job_id}/download-all';">📦</button>`
        : (j.status === "running" ? "⏳" : "—");
      rows += `<tr onclick="console.log('${j.job_id}')">
        <td><span class="status-badge ${statusCls}">${j.status}</span></td>
        <td>${tcPill}</td>
        <td><code style="font-size:8pt;">${j.job_id}</code></td>
        <td title="${(j.input_files||[]).join(', ')}">${inputs}</td>
        <td>${outN}</td>
        <td>${enc}</td>
        <td>${dur}</td>
        <td>${actions}</td>
      </tr>`;
    }
    rows += "</tbody></table>";
    c.innerHTML = `<p style="font-size:9pt;color:var(--text-muted);">${d.total} jobs total</p>` + rows;
  } catch (e) {
    $("historyContent").innerHTML = `<p class="preset-empty">❌ Error: ${e.message}</p>`;
  }
}
$("historyBtn").addEventListener("click", showHistoryModal);
document.addEventListener("keydown", (e) => {
  if (e.ctrlKey && e.key === "h") { e.preventDefault(); showHistoryModal(); }
});

// === Saved Presets (localStorage) ===
const PRESETS_KEY = "sj88_greenscreen_presets_v1";
function loadPresets() {
  try { return JSON.parse(localStorage.getItem(PRESETS_KEY) || "[]"); } catch { return []; }
}
function savePresets(p) { localStorage.setItem(PRESETS_KEY, JSON.stringify(p)); }
function captureCurrentSettings() {
  const fields = ["width", "height", "fps", "bitrate", "encoder", "preset",
                  "key_color", "similarity", "blend", "despill",
                  "use_center", "use_left", "use_right", "max_parallel",
                  "segment_duration", "match_mode", "seed", "reframe_mode"];
  const out = {};
  for (const f of fields) {
    const el = $("f-" + f);
    if (el) out[f] = el.type === "checkbox" ? el.checked : el.value;
  }
  return out;
}
function applySettings(s) {
  for (const [k, v] of Object.entries(s)) {
    const el = $("f-" + k);
    if (el) {
      if (el.type === "checkbox") el.checked = !!v;
      else el.value = v;
    }
  }
  updateMatrix(); updateCount();
}
function showPresetsModal() {
  let m = $("presetsModal");
  if (m) m.remove();
  m = document.createElement("div");
  m.id = "presetsModal";
  m.className = "help-modal-backdrop";
  m.innerHTML = `
    <div class="help-modal presets-modal" onclick="event.stopPropagation()">
      <button class="close-btn" onclick="$('presetsModal').remove()">✕ ปิด</button>
      <h2>⭐ Presets</h2>
      <p style="font-size:10pt;color:var(--text-secondary);">Save current settings as a preset, or load one to restore values.</p>
      <div style="display:flex;gap:6px;margin:12px 0;">
        <input id="presetName" type="text" placeholder="Preset name (เช่น 9:16 Tiktok 1080p)" 
               style="flex:1;padding:8px;background:var(--bg-raised);border:1px solid var(--border);color:var(--text-primary);border-radius:4px;font-size:10pt;">
        <button class="header-btn" id="savePresetBtn" style="background:var(--tc01);color:#000;">💾 Save</button>
      </div>
      <div class="presets-list" id="presetsList"></div>
    </div>
  `;
  m.addEventListener("click", () => m.remove());
  document.body.appendChild(m);
  renderPresetsList();
  $("savePresetBtn").addEventListener("click", () => {
    const name = $("presetName").value.trim();
    if (!name) { toast("⚠️", "ใส่ชื่อ preset ก่อน", "warn", 2000); return; }
    const settings = captureCurrentSettings();
    settings._name = name;
    settings._created = new Date().toISOString();
    const all = loadPresets();
    all.unshift(settings);
    savePresets(all.slice(0, 20));
    $("presetName").value = "";
    renderPresetsList();
    toast("⭐ Saved", `Preset "${name}" บันทึกแล้ว`, "success", 2000);
  });
}
function renderPresetsList() {
  const all = loadPresets();
  const c = $("presetsList");
  if (!c) return;
  if (all.length === 0) {
    c.innerHTML = '<p class="preset-empty">ยังไม่มี preset — save อันแรกเลย!</p>';
    return;
  }
  c.innerHTML = all.map((p, i) => {
    const meta = `${p.width||"?"}×${p.height||"?"} @${p.fps||"?"}fps · ${p.encoder||"auto"} · ${p.preset||"medium"}`;
    return `<div class="preset-item">
      <div>
        <div class="preset-name">${p._name}</div>
        <div class="preset-meta">${meta}</div>
      </div>
      <div>
        <button class="header-btn" onclick="applyPreset(${i})">📥 Load</button>
        <button class="header-btn" onclick="deletePreset(${i})" style="background:rgba(239,68,68,0.15);color:var(--danger);">🗑</button>
      </div>
    </div>`;
  }).join("");
}
function applyPreset(i) {
  const all = loadPresets();
  if (all[i]) {
    applySettings(all[i]);
    toast("📥 Loaded", `Preset "${all[i]._name}" applied`, "success", 2000);
    $("presetsModal").remove();
  }
}
function deletePreset(i) {
  if (!confirm("ลบ preset นี้?")) return;
  const all = loadPresets();
  all.splice(i, 1);
  savePresets(all);
  renderPresetsList();
}
$("presetsBtn").addEventListener("click", showPresetsModal);
document.addEventListener("keydown", (e) => {
  if (e.ctrlKey && e.key === "s") { e.preventDefault(); showPresetsModal(); }
  if (e.key === "Escape") { closeGalleryPlayer(); }
});

/* ==================== Video Gallery Logic (v3.GALLERY) ==================== */
const galleryState = { page: 1, limit: 5, dir: "", total: 0, pages: 1 };

function formatBytes(n) {
  if (n < 1024) return n + "B";
  if (n < 1024 * 1024) return (n / 1024).toFixed(1) + "K";
  return (n / 1024 / 1024).toFixed(1) + "M";
}

async function loadGallery(page = 1) {
  galleryState.page = page;
  const grid = document.getElementById("galleryGrid");
  const stats = document.getElementById("galleryStats");
  const pInfo = document.getElementById("galleryPageInfo");
  const prev = document.getElementById("galleryPrev");
  const next = document.getElementById("galleryNext");
  grid.innerHTML = '<div class="gallery-empty">⏳ Loading…</div>';
  stats.textContent = "Loading…";
  try {
    const url = new URL("/api/outputs", window.location.origin);
    url.searchParams.set("page", String(page));
    url.searchParams.set("limit", String(galleryState.limit));
    if (galleryState.dir) url.searchParams.set("dir", galleryState.dir);
    const r = await authFetch(url);
    const d = await r.json();
    galleryState.total = d.total || 0;
    galleryState.pages = d.pages || 1;
    if (d.page) galleryState.page = d.page;
    renderGallery(d.files || []);
    stats.textContent = `📊 ${galleryState.total} video${galleryState.total === 1 ? "" : "s"}`;
    pInfo.textContent = `Page ${galleryState.page} / ${galleryState.pages}`;
    prev.disabled = galleryState.page <= 1;
    next.disabled = galleryState.page >= galleryState.pages;
  } catch (err) {
    console.error("gallery load error", err);
    const authRequired = String(err?.message || "").includes("401");
    grid.innerHTML = authRequired
      ? '<div class="gallery-empty">🔒 ตั้งค่า API token ก่อนดู output</div>'
      : '<div class="gallery-error">❌ Failed to load gallery</div>';
    stats.textContent = authRequired ? "🔒 Token required" : "Error";
  }
}

function renderGallery(files) {
  const grid = document.getElementById("galleryGrid");
  if (!files.length) {
    grid.innerHTML = '<div class="gallery-empty">📭 No videos yet — render one to see it here!</div>';
    return;
  }
  grid.innerHTML = files.map(f => {
    const safeName = (f.path || "").replace(/[<>&"']/g, c =>
      ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;", "'": "&#39;" }[c]));
    const downloadUrl = `/api/download/${encodeURI(f.path)}`;
    return `
      <div class="gallery-card" data-path="${f.path}" onclick="playGalleryVideo('${safeName.replace(/'/g, "&#39;")}')">
        <video class="thumb" src="${downloadUrl}" preload="metadata" muted playsinline
               onerror="this.outerHTML='<div class=\'thumb-loading\'>⏳ unavailable…</div>'"></video>
        <div class="play-icon">▶</div>
        <div class="meta">
          <div class="name" title="${safeName}">${f.path.split("/").pop()}</div>
          <div class="info">
            <span>${f.mtime_iso || ""}</span>
            <span>${formatBytes(f.size)}</span>
          </div>
        </div>
      </div>`;
  }).join("");
}

function playGalleryVideo(path) {
  const modal = document.getElementById("galleryModal");
  const video = document.getElementById("galleryVideo");
  const name = document.getElementById("galleryModalName");
  video.src = `/api/download/${encodeURI(path)}`;
  video.load();
  video.play().catch(() => {});
  name.textContent = path;
  modal.classList.add("show");
}

function closeGalleryPlayer() {
  const modal = document.getElementById("galleryModal");
  const video = document.getElementById("galleryVideo");
  video.pause();
  video.removeAttribute("src");
  video.load();
  modal.classList.remove("show");
}

// Event listeners
document.getElementById("galleryPrev").addEventListener("click", () => {
  if (galleryState.page > 1) loadGallery(galleryState.page - 1);
});
document.getElementById("galleryNext").addEventListener("click", () => {
  if (galleryState.page < galleryState.pages) loadGallery(galleryState.page + 1);
});
document.getElementById("galleryRefresh").addEventListener("click", () => loadGallery(galleryState.page));
document.getElementById("galleryModalClose").addEventListener("click", closeGalleryPlayer);
document.getElementById("galleryModal").addEventListener("click", (e) => {
  if (e.target.id === "galleryModal") closeGalleryPlayer();
});
document.getElementById("galleryJump").addEventListener("keydown", (e) => {
  if (e.key === "Enter") {
    const p = parseInt(e.target.value, 10);
    if (p >= 1 && p <= galleryState.pages) loadGallery(p);
    e.target.value = "";
  }
});
document.querySelectorAll("#galleryFilters button").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll("#galleryFilters button").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    galleryState.dir = btn.getAttribute("data-dir");
    loadGallery(1);
  });
});

// Initial load + auto-refresh after renders
loadGallery(1);
// Re-load gallery when a render completes
let _lastBusy = null;
setInterval(() => {
  const busy = document.getElementById("busyLabel")?.textContent || "";
  if (_lastBusy && !busy.includes("⏸") && !busy.includes("Idle")) return;
  if (_lastBusy && busy.includes("⏸")) return; // still idle
}, 5000);
// Fallback: explicit auto-refresh every 30s
setInterval(() => loadGallery(galleryState.page), 30000);

// Also listen to "render complete" custom event
window.addEventListener("v3:render-complete", () => loadGallery(1));

// v3.GALLERY: Expose gallery functions to window so inline onclick handlers
// in dynamically-rendered HTML can call them. ES6 module scope hides them
// by default, which broke the play button until this exposure was added.
window.playGalleryVideo = playGalleryVideo;
window.closeGalleryPlayer = closeGalleryPlayer;
window.loadGallery = loadGallery;

/* ================================================================
   greenstats.sj88ai.com realtime dashboard (V3-integrated)
   ================================================================ */
(function() {
  const ENDPOINT = "/gs-api/public/summary";  // proxied via green.cutdee.com nginx (bypass CORS)
  const MAX_POINTS = 240;
  const TC_KEYS = ["TC01", "TC02", "TC03", "TC04", "TC05", "TC06"];
  const TC_COLORS = {
    TC01: "#4fc3f7", TC02: "#6fcf97", TC03: "#f0a35e",
    TC04: "#bb86fc", TC05: "#f06292", TC06: "#26c6da",
  };
  const state = { history: [], firstSnapshot: null, lastPerTC: {} };
  const fmt = n => n == null ? "—" : Number(n).toLocaleString();

  const totalsChart = new Chart(document.getElementById("gs-ch-totals"), {
    type: "bar",
    data: {
      labels: [],
      datasets: [
        { type: "bar", label: "Runs",      data: [], backgroundColor: "rgba(79,195,247,0.55)", borderColor: "#4fc3f7", borderWidth: 1, yAxisID: "y", stack: "a" },
        { type: "bar", label: "Successful", data: [], backgroundColor: "rgba(111,207,151,0.55)", borderColor: "#6fcf97", borderWidth: 1, yAxisID: "y", stack: "a" },
        { type: "line", label: "Success rate %", data: [], borderColor: "#f0a35e", backgroundColor: "rgba(240,163,94,0.1)", yAxisID: "y2", tension: 0.3, pointRadius: 0, borderWidth: 2 },
      ],
    },
    options: {
      responsive: true, maintainAspectRatio: false, animation: { duration: 200 },
      interaction: { mode: "index", intersect: false },
      scales: {
        x: { stacked: true, ticks: { color: "#7b8aa3", maxRotation: 0, autoSkipPadding: 24 }, grid: { color: "rgba(36,48,66,0.4)" } },
        y: { stacked: true, ticks: { color: "#7b8aa3" }, grid: { color: "rgba(36,48,66,0.4)" }, beginAtZero: true },
        y2: { position: "right", ticks: { color: "#f0a35e", callback: v => v + "%" }, grid: { drawOnChartArea: false }, min: 0, max: 100 },
      },
      plugins: { legend: { labels: { color: "#d8e1ee", font: { size: 10 } } } },
    },
  });

  const tcChart = new Chart(document.getElementById("gs-ch-tc"), {
    type: "bar",
    data: { labels: [], datasets: TC_KEYS.map(tc => ({ label: tc, data: [], backgroundColor: TC_COLORS[tc] + "cc", borderColor: TC_COLORS[tc], borderWidth: 1, stack: "a" })) },
    options: {
      responsive: true, maintainAspectRatio: false, animation: { duration: 200 },
      scales: {
        x: { stacked: true, ticks: { color: "#7b8aa3", maxRotation: 0, autoSkipPadding: 24 }, grid: { color: "rgba(36,48,66,0.4)" } },
        y: { stacked: true, ticks: { color: "#7b8aa3" }, grid: { color: "rgba(36,48,66,0.4)" }, beginAtZero: true },
      },
      plugins: { legend: { labels: { color: "#d8e1ee", font: { size: 10 } } } },
    },
  });

  const rateChart = new Chart(document.getElementById("gs-ch-rate"), {
    type: "line",
    data: { labels: [], datasets: TC_KEYS.map(tc => ({ label: tc, data: [], borderColor: TC_COLORS[tc], backgroundColor: TC_COLORS[tc] + "22", tension: 0.25, pointRadius: 0, borderWidth: 2, fill: false })) },
    options: {
      responsive: true, maintainAspectRatio: false, animation: { duration: 200 },
      scales: {
        x: { ticks: { color: "#7b8aa3", maxRotation: 0, autoSkipPadding: 24 }, grid: { color: "rgba(36,48,66,0.4)" } },
        y: { min: 0, max: 100, ticks: { color: "#7b8aa3", callback: v => v + "%" }, grid: { color: "rgba(36,48,66,0.4)" } },
      },
      plugins: { legend: { labels: { color: "#d8e1ee", font: { size: 10 } } } },
    },
  });

  async function pollGS() {
    const t0 = Date.now();
    try {
      const r = await fetch(ENDPOINT, { cache: "no-store" });
      if (!r.ok) throw new Error("HTTP " + r.status);
      const d = await r.json();
      const t = new Date();
      const ts = t.toLocaleTimeString("en-GB", { hour12: false });
      const runs = d.runs || 0, ok = d.successful_runs || 0;
      const fail = Math.max(0, runs - ok);
      const rate = runs > 0 ? (ok / runs) * 100 : 0;
      const perTC = {};
      for (const it of (d.items || [])) perTC[it.tc] = { inputs: it.input_count, outputs: it.output_count, runs: it.runs, ok: it.successful_runs, rate: it.success_rate };
      state.history.push({ t, ts, runs, ok, fail, rate, perTC });
      if (state.history.length > MAX_POINTS) state.history.shift();
      if (!state.firstSnapshot) state.firstSnapshot = { runs, ok, fail, rate };
      state.lastPerTC = perTC;

      document.getElementById("gs-kpi-runs").textContent = fmt(runs);
      document.getElementById("gs-kpi-ok").textContent = fmt(ok);
      document.getElementById("gs-kpi-fail").textContent = fmt(fail);
      document.getElementById("gs-kpi-rate").textContent = rate.toFixed(2) + "%";
      document.getElementById("gs-kpi-runs-d").textContent = "+" + (runs - state.firstSnapshot.runs) + " since start";
      document.getElementById("gs-kpi-ok-d").textContent = "+" + (ok - state.firstSnapshot.ok) + " since start";
      document.getElementById("gs-kpi-fail-d").textContent = "+" + (fail - state.firstSnapshot.fail) + " since start";
      const dr = rate - state.firstSnapshot.rate;
      const drEl = document.getElementById("gs-kpi-rate-d");
      drEl.textContent = (dr >= 0 ? "+" : "") + dr.toFixed(2) + "% since start";
      drEl.className = "delta " + (dr >= 0 ? "up" : "bad");

      const labels = state.history.map(h => h.ts);
      totalsChart.data.labels = labels;
      totalsChart.data.datasets[0].data = state.history.map(h => h.runs);
      totalsChart.data.datasets[1].data = state.history.map(h => h.ok);
      totalsChart.data.datasets[2].data = state.history.map(h => +h.rate.toFixed(2));
      totalsChart.update();

      tcChart.data.labels = labels;
      TC_KEYS.forEach((tc, i) => { tcChart.data.datasets[i].data = state.history.map(h => h.perTC[tc]?.runs || 0); });
      tcChart.update();

      rateChart.data.labels = labels;
      TC_KEYS.forEach((tc, i) => { rateChart.data.datasets[i].data = state.history.map(h => h.perTC[tc]?.rate || 0); });
      rateChart.update();

      // Table
      const recent = state.history.slice(-60);
      const recentFirst = recent[0] || null;
      const dRuns = (tc) => recentFirst ? (state.lastPerTC[tc]?.runs || 0) - (recentFirst.perTC[tc]?.runs || 0) : 0;
      document.getElementById("gs-tbody").innerHTML = TC_KEYS.map(tc => {
        const r = state.lastPerTC[tc];
        if (!r) return "<tr><td>" + tc + "</td><td colspan=7 style=text-align:right;color:#7b8aa3>no data</td></tr>";
        const failed = Math.max(0, r.runs - r.ok);
        const dr = dRuns(tc);
        const rc = r.rate >= 95 ? "pill-ok" : (r.rate >= 80 ? "pill-warn" : "pill-err");
        return "<tr>" +
          "<td style=padding:6px 8px><strong style=color:" + TC_COLORS[tc] + ">" + tc + "</strong></td>" +
          "<td style=text-align:right;padding:6px 8px>" + fmt(r.inputs) + "</td>" +
          "<td style=text-align:right;padding:6px 8px>" + fmt(r.outputs) + "</td>" +
          "<td style=text-align:right;padding:6px 8px>" + fmt(r.runs) + "</td>" +
          "<td style=text-align:right;padding:6px 8px>" + fmt(r.ok) + "</td>" +
          "<td style=text-align:right;padding:6px 8px>" + fmt(failed) + "</td>" +
          "<td style=text-align:right;padding:6px 8px><span class=\"pill \" + rc + \">" + r.rate.toFixed(2) + "%</span></td>" +
          "<td style=text-align:right;padding:6px 8px>" + (dr > 0 ? "+" + dr : dr) + "</td>" +
        "</tr>";
      }).join("");

      document.getElementById("gs-conn").textContent = "● live · " + (Date.now() - t0) + "ms";
      document.getElementById("gs-conn").className = "conn live";
      document.getElementById("gs-lastAt").textContent = "last " + ts;
      document.getElementById("gs-lastUpdate2").textContent = "updated " + ts;
    } catch (e) {
      document.getElementById("gs-conn").textContent = "● " + e.message;
      document.getElementById("gs-conn").className = "conn err";
    }
  }

  // Start polling when tab is opened (saves CPU when not visible)
  let _gsTimer = null;
  function startGS() {
    if (_gsTimer) return;
    pollGS();
    _gsTimer = setInterval(pollGS, 5000);
  }
  function stopGS() {
    if (_gsTimer) { clearInterval(_gsTimer); _gsTimer = null; }
  }
  // ---------- Failure breakdown (local V3 jobs) ----------
  const FB_PALETTE = {
    success: "#6fcf97",
    ffmpeg_exit: "#eb6e6e",
    watchdog_wall: "#f0a35e",
    watchdog_idle: "#f5c987",
    vram_cap: "#bb86fc",
    invalid_input: "#9aa0a6",
    cancelled: "#7b8aa3",
    oom: "#eb6e6e",
    engine_exception: "#eb6e6e",
    spawn_error: "#eb6e6e",
  };
  const FB_LABELS = {
    success: "✅ Success",
    ffmpeg_exit: "❌ ffmpeg_exit",
    watchdog_wall: "⏱ watchdog_wall",
    watchdog_idle: "⏱ watchdog_idle",
    vram_cap: "💾 vram_cap",
    invalid_input: "⚠ invalid_input",
    cancelled: "🚫 cancelled",
    oom: "💥 oom",
    engine_exception: "💥 engine_exception",
    spawn_error: "💥 spawn_error",
  };
  const fbChart = new Chart(document.getElementById("gs-ch-failures"), {
    type: "doughnut",
    data: { labels: [], datasets: [{ data: [], backgroundColor: [] }] },
    options: {
      responsive: true, maintainAspectRatio: false,
      animation: { duration: 200 },
      plugins: { legend: { position: "right", labels: { color: "#d8e1ee", font: { size: 11 } } } },
    },
  });
  let fbCache = [];
  async function pollFailures() {
    try {
      const r = await authFetch("/api/jobs/list?limit=200", { cache: "no-store" });
      if (!r.ok) throw new Error("HTTP " + r.status);
      const d = await r.json();
      const counts = {};
      for (const j of (d.jobs || [])) {
        const fc = (j.metadata || {}).failure_code || (j.status === "succeeded" ? "success" : "engine_exception");
        counts[fc] = (counts[fc] || 0) + 1;
      }
      fbCache = counts;
      const entries = Object.entries(counts).sort((a, b) => b[1] - a[1]);
      const total = entries.reduce((s, [, n]) => s + n, 0);
      fbChart.data.labels = entries.map(([k]) => FB_LABELS[k] || k);
      fbChart.data.datasets[0].data = entries.map(([, n]) => n);
      fbChart.data.datasets[0].backgroundColor = entries.map(([k]) => FB_PALETTE[k] || "#4fc3f7");
      fbChart.update();
      document.getElementById("gs-fb-count").textContent = total;
      document.getElementById("gs-fb-tbody").innerHTML = entries.map(([k, n]) => {
        const pct = total > 0 ? (n / total * 100).toFixed(1) : 0;
        const barW = Math.max(2, (n / total * 100)).toFixed(1);
        const c = FB_PALETTE[k] || "#4fc3f7";
        return "<tr>" +
          "<td style=padding:6px 8px><strong style=color:" + c + ">" + (FB_LABELS[k] || k) + "</strong></td>" +
          "<td style=text-align:right;padding:6px 8px>" + n + "</td>" +
          "<td style=text-align:right;padding:6px 8px>" + pct + "%</td>" +
          "<td style=padding:6px 8px><div style=width:" + barW + "%;height:8px;background:" + c + ";border-radius:4px;></div></td>" +
        "</tr>";
      }).join("");
    } catch (e) {
      console.error("pollFailures error", e);
    }
  }
  // Hook into tab switcher
  const _origClick = document.querySelectorAll(".tab");
  document.querySelectorAll(".tab").forEach(t => {
    t.addEventListener("click", () => {
      if (t.dataset.tab === "stats") { startGS(); pollFailures(); }
      else stopGS();
    });
  });
  // Also start if stats is the initial active tab
  if (document.querySelector(".tab.active")?.dataset.tab === "stats") { startGS(); pollFailures(); }
  // Re-poll failures every 10s while stats tab is visible
  setInterval(() => {
    if (document.querySelector(".tab.active")?.dataset.tab === "stats") pollFailures();
  }, 10000);
})();
</script>
<script src="/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js" data-cf-settings="13db993d3a7f54f9fd842fb2-|49" defer></script><script type="7758521211ae44d4b1e2c246-text/javascript">
(function() {
  const API = "";  // same origin
  const PORTAL = "/api/app";
  const COOKIE_NAME = "cutdee_session";

  async function api(method, url, body) {
    const opts = { method, headers: {}, credentials: "same-origin" };
    if (body) { opts.headers["Content-Type"] = "application/json"; opts.body = JSON.stringify(body); }
    const r = await fetch(API + url, opts);
    const text = await r.text();
    let d; try { d = JSON.parse(text); } catch { d = { ok:false, error: text }; }
    return d;
  }
  function esc(s) { return String(s ?? "").replace(/[<>&"']/g, c => ({"<":"&lt;",">":"&gt;","&":"&amp;",'"':"&quot;","'":"&#39;"}[c])); }
  function fmtAgo(epoch) {
    if (!epoch) return "—";
    const dt = Date.now()/1000 - - epoch;
    if (dt < 60) return Math.floor(dt) + "s ago";
    if (dt < 3600) return Math.floor(dt/60) + "m ago";
    if (dt < 86400) return Math.floor(dt/3600) + "h ago";
    return Math.floor(dt/86400) + "d ago";
  }
  function fmtSize(b) { if (!b) return "—"; const u = ["B","KB","MB","GB"]; let i=0, v=b; while (v>=1024 && i<u.length-1) { v/=1024; i++; } return v.toFixed(1)+" "+u[i]; }
  function fmtSec(s) { if (s==null || s===0) return "—"; if (s<60) return s.toFixed(1)+"s"; if (s<3600) return Math.floor(s/60)+"m"; return Math.floor(s/3600)+"h"; }

  // ============== Member bar (header) ==============
  function renderMemberBar(me) {
    const authBtn = document.getElementById("authBtn");
    if (!authBtn) return;
    // Replace the API token button with our member bar
    const bar = document.createElement("div");
    bar.id = "memberBar";
    bar.style.cssText = "display:flex;align-items:center;gap:8px;margin-left:8px;padding:0 4px;border-left:1px solid var(--border);";
    if (!me) {
      // Not logged in → Sign up + Sign in buttons
      bar.innerHTML = `
        <button class="header-btn" id="memberSignupBtn" style="background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border:none;font-weight:600" title="Create free account">✨ Sign up</button>
        <button class="header-btn" id="memberLoginBtn" title="Sign in to existing account">🔑 Sign in</button>
      `;
    } else {
      // Logged in → User chip with dropdown
      const pct = Math.round(100 * me.user.monthly_used / Math.max(me.user.monthly_quota, 1));
      const u = me.user;
      bar.innerHTML = `
        <div id="memberChip" style="position:relative;display:flex;align-items:center;gap:8px;padding:4px 12px;background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.3);border-radius:16px;cursor:pointer;color:#86efac;font-size:10pt">
          <div style="width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#22c55e,#10b981);display:flex;align-items:center;justify-content:center;font-size:12px;color:#0a0c14;font-weight:600">${esc((u.display_name||u.email||u.user_id).slice(0,2).toUpperCase())}</div>
>
          <div style="display:flex;flex-direction:column;line-height:1.2">
            <strong>${esc(u.display_name || u.email)}</strong>
            <span style="color:#9aa0b4;font-size:9pt">${u.monthly_used}/${u.monthly_quota} jobs · ${pct}% quota</span>
          </div>
          <span style="color:#9aa0b4;font-size:8pt">▾</span>
        </div>
      `;
    }
    authBtn.style.display = "none";
    authBtn.parentNode.insertBefore(bar, authBtn);
  }

  function renderDropdown() {
    const menu = document.createElement("div");
    menu.id = "memberDropdown";
    menu.style.cssText = "position:absolute;top:calc(100% + 6px);right:0;background:#16161f;border:1px solid var(--border);border-radius:10px;padding:6px;min-width:240px;box-shadow:0 10px 30px rgba(0,0,0,0.5);z-index:1000;display:none";
    menu.innerHTML = `
      <a href="/api/app" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt" onmouseover="this.style.background='#28283a'" onmouseout="this.style.background='transparent'">>👤 My Dashboard</a>
      <a href="/api/app/jobs" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt" onmouseover="this.style.background='#28283a'" onmouseout="this.style.background='transparent'">📜 My Jobs</a>
      <a href="/api/app/submit" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;font-weight:600" onmouseover="this.style.filter='brightness(1.1)'" onmouseout="this.style.filter='none'">+ Submit Job</a>
      <hr style="border:none;border-top:1px solid var(--border);margin:4px 0">
      <button id="logoutBtn" style="width:100%;text-align:left;background:transparent;border:none;color:#9aa0b4;padding:8px 12px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11pt" onmouseover="this.style.background='#28283a';this.style.color='#ef4444'" onmouseout="this.style.background='transparent';this.style.color='#9aa0b4'">↪ Sign out</button>
    `;
    document.body.appendChild(menu);
  }

  function showDropdown() {
    const menu = document.getElementById("memberDropdown");
    const chip = document.getElementById("memberChip");
    if (!menu || !chip) return;
    const r = chip.getBoundingClientRect();
    menu.style.top = (r.bottom + 4) + "px";
    menu.style.right = (window.innerWidth - r.right) + "px";
    menu.style.display = "block";
  }

  async function loadAndRender() {
    let me = null;
    try { const r = await api("GET", "/api/v1/auth/me"); if (r.ok) me = r; } catch {}
    renderMemberBar(me);
    if (me) {
      renderDropdown();
      const chip = document.getElementById("memberChip");
      chip?.addEventListener("click", e => { e.stopPropagation(); showDropdown(); });
      document.getElementById("logoutBtn")?.addEventListener("click", async () => {
        await api("POST", "/api/v1/auth/logout", {});
        location.reload();
      });
      document.addEventListener("click", () => {
        const menu = document.getElementById("memberDropdown");
        if (menu) menu.style.display = "none";
      });
      // Load job history panel
      loadJobHistory();
    }
  }

  // ============== Job history panel ==============
  async function loadJobHistory() {
    const d = await api("GET", "/api/v1/users/me/jobs?limit=10");
    const jobs = d.jobs || [];
    if (!jobs.length) return;
    // Insert a "Recent Jobs" panel below the tabs (after <nav class="tabs">)
    const nav = document.querySelector("nav.tabs");
    if (!nav) return;
    const panel = document.createElement("section");
    panel.id = "myJobsPanel";
    panel.style.cssText = "margin:0 24px 24px;background:#16161f;border:1px solid var(--border);border-radius:10px;padding:18px";
    panel.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
        <h3 style="margin:0;font-size:13pt;color:var(--text-primary)">📋 ประวัติงานของฉัน</h3>
        <div>
          <a href="/api/app/submit" style="display:inline-flex;align-items:center;gap:4px;padding:6px 14px;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border-radius:6px;text-decoration:none;font-weight:500;font-size:10pt;margin-right:8px">+ Submit Job</a>
          <a href="/api/app/jobs" style="display:inline-flex;align-items:center;gap:4px;padding:6px 12px;background:transparent;border:1px solid var(--border);color:var(--text-secondary);border-radius:6px;text-decoration:none;font-size:10pt">View all →</a>
        </div>
      </div>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:10pt">
          <thead>
            <tr style="border-bottom:1px solid var(--border);color:var(--text-muted);text-align:left;font-size:9pt;text-transform:uppercase;letter-spacing:0.04em">
              <th style="padding:8px 10px">Job ID</th>
              <th style="padding:8px 10px">TC</th>
              <th style="padding:8px 10px">Status</th>
              <th style="padding:8px 10px">Worker</th>
              <th style="padding:8px 10px">Size</th>
              <th style="padding:8px 10px">Duration</th>
              <th style="padding:8px 10px">Created</th>
            </tr>
          </thead>
          <tbody>
            ${jobs.map(j => {
              const tcColor = {tc01:"#4CAF50",tc02:"#A855F7",tc03:"#3B82F6",tc04:"#06B6D4",tc05:"#F59E0B",tc06:"#EC4899"}[j.tc] || "#6e6e82";
              const statusColor = {succeeded:"#10B981",running:"#3B82F6",queued:"#F59E0B",failed:"#EF4444",paused:"#A855F7",SUCCEEDED:"#10B981",FAILED:"#EF4444",INVALID_INPUT:"#A855F7"}[j.status] || "#9aa0b8";
              const duration = (j.started_at && j.finished_at) ? (j.finished_at - j.started_at).toFixed(1) + "s" : "—";
              return `<tr style="border-bottom:1px solid var(--border);">
                <td style="padding:8px 10px;font-family:'SF Mono',Consolas,monospace;font-size:9pt"><a href="/api/app/job/${encodeURIComponent(j.job_id)}" style="color:#60a5fa;text-decoration:none">${esc(j.job_id?.slice(-12))}</a></td>
                <td style="padding:8px 10px"><span style="display:inline-block;padding:2px 8px;background:${tcColor}22;color:${tcColor};border-radius:3px;font-size:9pt;font-weight:600">${esc((j.tc||"").toUpperCase())}</span></td>
                <td style="padding:8px 10px"><span style="color:${statusColor};font-weight:500">${esc(j.status)}</span></td>
                <td style="padding:8px 10px;color:var(--text-muted);font-family:'SF Mono',Consolas,monospace;font-size:9pt">${esc(j.worker_id || "—")}</td>
                <td style="padding:8px 10px;color:var(--text-secondary)">${j.output_size ? fmtSize(j.output_size) : "—"}</td>
                <td style="padding:8px 10px;color:var(--text-secondary);font-variant-numeric:tabular-nums">${duration}</td>
                <td style="padding:8px 10px;color:var(--text-muted)">${fmtAgo(j.created_at)}</td>
              </tr>`;
            }).join("")}
          </tbody>
        </table>
      </div>
    `;
    nav.parentNode.insertBefore(panel, nav.nextSibling);
  }

  // ============== Login modal ==============
  function showLoginModal() {
    const m = document.createElement("div");
    m.id = "memberLoginModal";
    m.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px";
    m.innerHTML = `
      <div style="background:#16161f;border:1px solid var(--border);border-radius:16px;padding:28px;max-width:420px;width:100%">
        <h2 style="margin:0 0 4px;font-size:18pt;color:var(--text-primary)">🔑 Sign in</h2>
        <p style="margin:0 0 18px;color:var(--text-muted);font-size:10pt">Sign in with your V3 Studio account.</p>
        <div id="loginErr" style="display:none;background:rgba(239,68,68,0.15);color:#fca5a5;padding:10px 14px;border-radius:8px;border:1px solid rgba(239,68,68,0.3);font-size:10pt;margin-bottom:12px"></div>
        <form id="loginForm" style="display:flex;flex-direction:column;gap:12px">
          <div>
            <label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px">Email</label>
            <input type="email" name="email" required style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit">
          </div>
          <div>
            <label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px">Password</label>
            <input type="password" name="password" required style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit">
          </div>
          <button type="submit" style="padding:10px 18px;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border:none;border-radius:7px;cursor:pointer;font-family:inherit;font-weight:500;font-size:11pt;margin-top:6px">Sign in</button>
        </form>
        <div style="text-align:center;margin-top:14px;font-size:10pt;color:var(--text-muted)">
          No account? <a href="#" id="showSignupLink" style="color:#60a5fa">Create one in 30s →</a>
        </div>
        <button id="closeLoginModal" style="position:absolute;top:14px;right:14px;background:transparent;border:none;color:var(--text-muted);cursor:pointer;font-size:20pt;line-height:1">&times;</button>
      </div>
    `;
    document.body.appendChild(m);
    document.getElementById("closeLoginModal").onclick = () => m.remove();
    document.getElementById("showSignupLink").onclick = (e) => { e.preventDefault(); m.remove(); showSignupModal(); };
    document.getElementById("loginForm").onsubmit = async (e) => {
      e.preventDefault();
      const email = e.target.email.value.trim();
      const password = e.target.password.value;
      try {
        await api("POST", "/api/v1/auth/login", { email, password });
        location.reload();
      } catch (err) {
        const errDiv = document.getElementById("loginErr");
        errDiv.textContent = "✕ " + err.message;
        errDiv.style.display = "block";
      }
    };
  }

  function showSignupModal() {
    const m = document.createElement("div");
    m.id = "memberSignupModal";
    m.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px";
    m.innerHTML = `
      <div style="background:#16161f;border:1px solid var(--border);border-radius:16px;padding:28px;max-width:420px;width:100%">
        <h2 style="margin:0 0 4px;font-size:18pt;color:var(--text-primary)">✨ Create account</h2>
        <p style="margin:0 0 18px;color:var(--text-muted);font-size:10pt">100 free renders/month · no credit card.</p>
        <div id="signupErr" style="display:none;background:rgba(239,68,68,0.15);color:#fca5a5;padding:10px 14px;border-radius:8px;border:1px solid rgba(239,68,68,0.3);font-size:10pt;margin-bottom:12px"></div>
        <div id="signupOk" style="display:none;background:rgba(34,197,94,0.15);color:#86efac;padding:10px 14px;border-radius:8px;border:1px solid rgba(34,197,94,0.3);font-size:10pt;margin-bottom:12px"></div>
        <form id="signupForm" style="display:flex;flex-direction:column;gap:12px">
          <div>
            <label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px">Email</label>
            <input type="email" name="email" required style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit">
          </div>
          <div>
            <label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px">Display name (optional)</label>
            <input type="text" name="display_name" style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit">
          </div>
          <div>
            <label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:5px">Password (min 8 chars)</label>
            <input type="password" name="password" required minlength="8" style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit">
          </div>
          <button type="submit" style="padding:10px 18px;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border:none;border-radius:7px;cursor:pointer;font-family:inherit;font-weight:500;font-size:11pt;margin-top:6px">Create account</button>
        </form>
        <div style="text-align:center;margin-top:14px;font-size:10pt;color:var(--text-muted)">
          Have an account? <a href="#" id="showLoginLink" style="color:#60a5fa">Sign in →</a>
        </div>
        <button id="closeSignupModal" style="position:absolute;top:14px;right:14px;background:transparent;border:none;color:var(--text-muted);cursor:pointer;font-size:20pt;line-height:1">&times;</button>
      </div>
    `;
    document.body.appendChild(m);
    document.getElementById("closeSignupModal").onclick = () => m.remove();
    document.getElementById("showLoginLink").onclick = (e) => { e.preventDefault(); m.remove(); showLoginModal(); };
    document.getElementById("signupForm").onsubmit = async (e) => {
      e.preventDefault();
      const email = e.target.email.value.trim();
      const display_name = e.target.display_name.value.trim() || null;
      const password = e.target.password.value;
      try {
        const data = await api("POST", "/api/v1/auth/signup", { email, password, display_name });
        const ok = document.getElementById("signupOk");
        ok.innerHTML = "✓ Account created! Your API key (save now): <div style='font-family:SF Mono,monospace;background:#0f0f1a;padding:8px;margin-top:6px;border-radius:4px;font-size:10pt;color:#fbbf24;word-break:break-all'>" + data.api_key + "</div><div style='margin-top:8px'>Signing you in...</div>";
        ok.style.display = "block";
        try { await navigator.clipboard.writeText(data.api_key); ok.innerHTML += "<div style='margin-top:4px;color:#22c55e'>✓ Copied to clipboard!</div>"; } catch {}
        setTimeout(() => location.reload(), 3000);
      } catch (err) {
        const errDiv = document.getElementById("signupErr");
        errDiv.textContent = "✕ " + err.message;
        errDiv.style.display = "block";
      }
    };
  }

  // ============== INIT ==============
  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(() => {
      loadAndRender().then(() => {
        document.getElementById("memberSignupBtn")?.addEventListener("click", showSignupModal);
        document.getElementById("memberLoginBtn")?.addEventListener("click", showLoginModal);
      });
    }, 100);
  });
})();
</script>
<script src="/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js" data-cf-settings="7758521211ae44d4b1e2c246-|49" defer></script><script type="9dee3366aadfb249916fac86-text/javascript">
(function() {
  const API = "";  // same origin
  const PORTAL = "/api/app";
  let _me = null;
  let _knownJobIds = new Set();

  async function api(method, url, body) {
    const opts = { method, headers: {}, credentials: "same-origin" };
    if (body) { opts.headers["Content-Type"] = "application/json"; opts.body = JSON.stringify(body); }
    const r = await fetch(API + url, opts);
    const text = await r.text();
    let d; try { d = JSON.parse(text); } catch { d = { ok:false, error: text }; }
    if (!r.ok) throw new Error(d.detail || d.error || r.statusText);
    return d;
  }
  function esc(s) { return String(s ?? "").replace(/[<>&"']/g, c => ({"<":"&lt;",">":"&gt;","&":"&amp;",'"':"&quot;","'":"&#39;"}[c])); }
  function fmtAgo(epoch) { if (!epoch) return "—"; const dt = Date.now()/1000 - epoch; if (dt<60) return Math.floor(dt)+"s ago"; if (dt<3600) return Math.floor(dt/60)+"m ago"; if (dt<86400) return Math.floor(dt/3600)+"h ago"; return Math.floor(dt/86400)+"d ago"; }
  function fmtSize(b) { if (!b) return "—"; const u = ["B","KB","MB","GB"]; let i=0, v=b; while (v>=1024 && i<u.length-1) { v/=1024; i++; } return v.toFixed(1)+" "+u[i]; }
  function fmtSec(s) { if (s==null || s===0) return "—"; if (s<60) return s.toFixed(1)+"s"; if (s<3600) return Math.floor(s/60)+"m"; return Math.floor(s/3600)+"h"; }

  // ============== Toast notification system ==============
  function ensureToastContainer() {
    let c = document.getElementById("v3ToastContainer");
    if (!c) {
      c = document.createElement("div");
      c.id = "v3ToastContainer";
      c.style.cssText = "position:fixed;top:80px;right:24px;z-index:99999;display:flex;flex-direction:column;gap:10px;max-width:360px;pointer-events:none";
      document.body.appendChild(c);
    }
    return c;
  }
  function showToast(title, message, link, color = "#22c55e") {
    const c = ensureToastContainer();
    const t = document.createElement("div");
    t.style.cssText = `background:#16161f;border:1px solid ${color};border-left:4px solid ${color};border-radius:8px;padding:14px 16px;box-shadow:0 8px 24px rgba(0,0,0,0.4);font-family:inherit;animation:slideIn 0.3s ease;pointer-events:auto;display:flex;align-items:flex-start;gap:10px`;
    const icon = color === "#22c55e" ? "✓" : color === "#ef4444" ? "✕" : color === "#f59e0b" ? "⏵" : "ℹ";
    t.innerHTML = `
      <div style="color:${color};font-size:18pt;line-height:1">${icon}</div>
      <div style="flex:1;min-width:0">
        <div style="font-weight:600;color:var(--text-primary);margin-bottom:4px">${esc(title)}</div>
        <div style="color:var(--text-secondary);font-size:10pt;line-height:1.4">${esc(message)}</div>
        ${link ? `<a href="${esc(link)}" style="display:inline-block;margin-top:6px;color:#60a5fa;text-decoration:none;font-size:10pt">View details →</a>` : ""}
      </div>
      <button onclick="this.parentNode.remove()" style="background:transparent;border:none;color:var(--text-muted);cursor:pointer;font-size:14pt;line-height:1;padding:0;margin-left:4px">×</button>
    `;
    c.appendChild(t);
    setTimeout(() => { if (t.parentNode) t.remove(); }, 12000);
  }
  // Inject CSS for animation
  if (!document.getElementById("v3ToastStyle")) {
    const s = document.createElement("style");
    s.id = "v3ToastStyle";
    s.textContent = "@keyframes slideIn { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }";
    document.head.appendChild(s);
  }

  // ============== Member bar (header) ==============
  function renderMemberBar(me) {
    const authBtn = document.getElementById("authBtn");
    if (!authBtn) return;
    const bar = document.createElement("div");
    bar.id = "memberBar";
    bar.style.cssText = "display:flex;align-items:center;gap:8px;margin-left:8px;padding:0 4px;border-left:1px solid var(--border)";
    if (!me) {
      bar.innerHTML = `
        <button class="header-btn" id="memberSignupBtn" style="background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border:none;font-weight:600">✨ Sign up</button>
        <button class="header-btn" id="memberLoginBtn">🔑 Sign in</button>
      `;
    } else {
      const u = me.user;
      const pct = Math.min(100, Math.round(100 * u.monthly_used / Math.max(u.monthly_quota, 1)));
      const pctColor = pct >= 90 ? "#ef4444" : pct >= 70 ? "#f59e0b" : "#22c55e";
      const initial = (u.display_name || u.email || u.user_id).slice(0, 2).toUpperCase();
      bar.innerHTML = `
        <div id="memberChip" style="position:relative;display:flex;align-items:center;gap:10px;padding:6px 14px 6px 6px;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:18px;cursor:pointer;color:#86efac;font-size:10pt;min-width:180px">
          <div style="width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#22c55e,#10b981);display:flex;align-items:center;justify-content:center;font-size:12px;color:#0a0c14;font-weight:600;flex-shrink:0">${esc(initial)}</div>
          <div style="display:flex;flex-direction:column;line-height:1.2;flex:1;min-width:0;overflow:hidden">
            <strong style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(u.display_name || u.email)}</strong>
            <div style="display:flex;align-items:center;gap:6px;margin-top:3px">
              <div style="flex:1;height:4px;background:rgba(255,255,255,0.08);border-radius:2px;overflow:hidden;max-width:120px">
                <div style="width:${pct}%;height:100%;background:${pctColor};border-radius:2px;transition:width 0.5s"></div>
              </div>
              <span style="color:#9aa0b4;font-size:8pt;font-variant-numeric:tabular-nums">${u.monthly_used}/${u.monthly_quota}</span>
            </div>
          </div>
          <span style="color:#9aa0b4;font-size:8pt">▾</span>
        </div>
      `;
    }
    authBtn.style.display = "none";
    authBtn.parentNode.insertBefore(bar, authBtn);
  }

  function renderDropdown() {
    const menu = document.createElement("div");
    menu.id = "memberDropdown";
    menu.style.cssText = "position:absolute;top:calc(100% + 6px);right:0;background:#16161f;border:1px solid var(--border);border-radius:10px;padding:6px;min-width:240px;box-shadow:0 10px 30px rgba(0,0,0,0.5);z-index:1000;display:none";
    menu.innerHTML = `
      <a href="/api/app" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt" onmouseover="this.style.background='#28283a'" onmouseout="this.style.background='transparent'">👤 My Dashboard</a>
      <a href="/api/app/jobs" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt" onmouseover="this.style.background='#28283a'" onmouseout="this.style.background='transparent'">📜 My Jobs</a>
      <a href="/api/app/submit" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;font-weight:600">+ Submit Job</a>
      <a href="/api/app/profile" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt" onmouseover="this.style.background='#28283a'" onmouseout="this.style.background='transparent'">⚙️ Profile</a>
      <hr style="border:none;border-top:1px solid var(--border);margin:4px 0">
      <button id="logoutBtn" style="width:100%;text-align:left;background:transparent;border:none;color:#9aa0b4;padding:8px 12px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11pt" onmouseover="this.style.background='#28283a';this.style.color='#ef4444'" onmouseout="this.style.background='transparent';this.style.color='#9aa0b4'">↪ Sign out</button>
    `;
    document.body.appendChild(menu);
  }

  function showDropdown() {
    const menu = document.getElementById("memberDropdown");
    const chip = document.getElementById("memberChip");
    if (!menu || !chip) return;
    const r = chip.getBoundingClientRect();
    menu.style.top = (r.bottom + 4) + "px";
    menu.style.right = (window.innerWidth - r.right) + "px";
    menu.style.display = "block";
  }

  // ============== Job history panel + actions ==============
  async function loadJobHistory() {
    const d = await api("GET", "/api/v1/users/me/jobs?limit=20");
    const jobs = d.jobs || [];
    if (!jobs.length) return;
    const nav = document.querySelector("nav.tabs");
    if (!nav) return;
    // Remove old panel if present
    document.getElementById("myJobsPanel")?.remove();

    // Track known jobs (for toast on completion)
    if (_knownJobIds.size === 0) {
      jobs.forEach(j => _knownJobIds.add(j.job_id));
    } else {
      // Detect newly completed
      const newJobs = jobs.filter(j => !_knownJobIds.has(j.job_id));
      for (const j of newJobs) {
        const color = j.status === "succeeded" ? "#22c55e" : j.status === "failed" ? "#ef4444" : "#60a5fa";
        const title = j.status === "succeeded" ? "Job completed ✓" : j.status === "failed" ? "Job failed" : "Job status: " + j.status;
        const msg = `${(j.tc||"").toUpperCase()} · ${j.output_size ? fmtSize(j.output_size) : "—"} · ${fmtAgo(j.created_at)}`;
        showToast(title, msg, `/api/app/job/${j.job_id}`, color);
        _knownJobIds.add(j.job_id);
      }
    }

    const panel = document.createElement("section");
    panel.id = "myJobsPanel";
    panel.style.cssText = "margin:0 24px 24px;background:#16161f;border:1px solid var(--border);border-radius:10px;padding:18px";
    panel.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
        <h3 style="margin:0;font-size:13pt;color:var(--text-primary)">📋 ประวัติงานของฉัน</h3>
        <div>
          <a href="/api/app/submit" style="display:inline-flex;align-items:center;gap:4px;padding:6px 14px;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border-radius:6px;text-decoration:none;font-weight:500;font-size:10pt;margin-right:8px">+ Submit Job</a>
          <a href="/api/app/jobs" style="display:inline-flex;align-items:center;gap:4px;padding:6px 12px;background:transparent;border:1px solid var(--border);color:var(--text-secondary);border-radius:6px;text-decoration:none;font-size:10pt">View all →</a>
        </div>
      </div>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:10pt">
          <thead>
            <tr style="border-bottom:1px solid var(--border);color:var(--text-muted);text-align:left;font-size:9pt;text-transform:uppercase;letter-spacing:0.04em">
              <th style="padding:8px 10px">Job ID</th>
              <th style="padding:8px 10px">TC</th>
              <th style="padding:8px 10px">Status</th>
              <th style="padding:8px 10px">Worker</th>
              <th style="padding:8px 10px">Size</th>
              <th style="padding:8px 10px">Duration</th>
              <th style="padding:8px 10px">Created</th>
              <th style="padding:8px 10px">Actions</th>
            </tr>
          </thead>
          <tbody>
            ${jobs.slice(0, 10).map(j => {
              const tcColor = {tc01:"#4CAF50",tc02:"#A855F7",tc03:"#3B82F6",tc04:"#06B6D4",tc05:"#F59E0B",tc06:"#EC4899"}[j.tc] || "#6e6e82";
              const statusColor = {succeeded:"#10B981",running:"#3B82F6",queued:"#F59E0B",failed:"#EF4444",paused:"#A855F7",SUCCEEDED:"#10B981",FAILED:"#EF4444",INVALID_INPUT:"#A855F7",deleted:"#6e6e82"}[j.status] || "#9aa0b8";
              const duration = (j.started_at && j.finished_at) ? (j.finished_at - j.started_at).toFixed(1) + "s" : (j.status === "running" ? "running..." : "—");
              const canCancel = (j.status === "running" || j.status === "queued");
              const actions = `
                <button data-jid="${esc(j.job_id)}" data-action="cancel" class="jobActionBtn" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.3);padding:3px 8px;border-radius:4px;font-size:9pt;cursor:pointer;font-family:inherit" title="Cancel running job">⏹ Cancel</button>
                <button data-jid="${esc(j.job_id)}" data-action="delete" class="jobActionBtn" style="background:rgba(107,114,128,0.15);color:#9aa0b4;border:1px solid rgba(107,114,128,0.3);padding:3px 8px;border-radius:4px;font-size:9pt;cursor:pointer;font-family:inherit;margin-left:4px" title="Delete job">🗑 Delete</button>
              `;
              return `<tr style="border-bottom:1px solid var(--border)">
                <td style="padding:8px 10px;font-family:'SF Mono',Consolas,monospace;font-size:9pt"><a href="/api/app/job/${encodeURIComponent(j.job_id)}" style="color:#60a5fa;text-decoration:none">${esc(j.job_id?.slice(-12))}</a></td>
                <td style="padding:8px 10px"><span style="display:inline-block;padding:2px 8px;background:${tcColor}22;color:${tcColor};border-radius:3px;font-size:9pt;font-weight:600">${esc((j.tc||"").toUpperCase())}</span></td>
                <td style="padding:8px 10px"><span style="color:${statusColor};font-weight:500">${esc(j.status)}</span></td>
                <td style="padding:8px 10px;color:var(--text-muted);font-family:'SF Mono',Consolas,monospace;font-size:9pt">${esc(j.worker_id || "—")}</td>
                <td style="padding:8px 10px;color:var(--text-secondary)">${j.output_size ? fmtSize(j.output_size) : "—"}</td>
                <td style="padding:8px 10px;color:var(--text-secondary);font-variant-numeric:tabular-nums">${duration}</td>
                <td style="padding:8px 10px;color:var(--text-muted)">${fmtAgo(j.created_at)}</td>
                <td style="padding:8px 10px">${canCancel ? actions : actions.replace(/⏹ Cancel<\/button>/, '')}</td>
              </tr>`;
            }).join("")}
          </tbody>
        </table>
      </div>
    `;
    nav.parentNode.insertBefore(panel, nav.nextSibling);
    // Wire up action buttons
    panel.querySelectorAll(".jobActionBtn").forEach(btn => {
      btn.addEventListener("click", async () => {
        const jid = btn.dataset.jid;
        const action = btn.dataset.action;
        if (action === "cancel") {
          if (!confirm(`Cancel job ${jid.slice(-12)}?`)) return;
          try {
            await api("POST", `/api/v1/jobs/${encodeURIComponent(jid)}/cancel`, {});
            showToast("Job cancelled", `${jid.slice(-12)} was cancelled`, null, "#f59e0b");
            setTimeout(loadJobHistory, 1500);
          } catch (e) { alert("Cancel failed: " + e.message); }
        } else if (action === "delete") {
          if (!confirm(`Delete job ${jid.slice(-12)}? This cannot be undone.`)) return;
          try {
            await api("DELETE", `/api/v1/jobs/${encodeURIComponent(jid)}`);
            showToast("Job deleted", `${jid.slice(-12)} was removed from history`, null, "#9aa0b4");
            setTimeout(loadJobHistory, 500);
          } catch (e) { alert("Delete failed: " + e.message); }
        }
      });
    });
  }

  // ============== Poll for new completions ==============
  async function pollJobs() {
    if (!_me) return;
    try {
      await loadJobHistory();
    } catch (e) { console.error("pollJobs", e); }
  }

  // ============== Auth modals ==============
  function showLoginModal() {
    const m = document.createElement("div");
    m.id = "memberLoginModal";
    m.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px";
    m.innerHTML = `
      <div style="background:#16161f;border:1px solid var(--border);border-radius:16px;padding:28px;max-width:420px;width:100%;position:relative">
        <h2 style="margin:0 0 4px;font-size:18pt;color:var(--text-primary)">🔑 Sign in</h2>
        <p style="margin:0 0 18px;color:var(--text-muted);font-size:10pt">Sign in to your V3 Studio account.</p>
        <div id="loginErr"></div>
        <form id="loginForm" style="display:flex;flex-direction:column;gap:12px">
          <div><label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;margin-bottom:5px">Email</label><input type="email" name="email" required style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit"></div>
          <div><label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;margin-bottom:5px">Password</label><input type="password" name="password" required style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit"></div>
          <button type="submit" style="padding:10px 18px;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border:none;border-radius:7px;cursor:pointer;font-family:inherit;font-weight:500;font-size:11pt;margin-top:6px">Sign in</button>
        </form>
        <div style="text-align:center;margin-top:14px;font-size:10pt;color:var(--text-muted)">No account? <a href="#" id="showSignupLink" style="color:#60a5fa">Create one in 30s →</a></div>
        <button id="closeLoginModal" style="position:absolute;top:14px;right:14px;background:transparent;border:none;color:var(--text-muted);cursor:pointer;font-size:20pt;line-height:1">&times;</button>
      </div>
    `;
    document.body.appendChild(m);
    document.getElementById("closeLoginModal").onclick = () => m.remove();
    document.getElementById("showSignupLink").onclick = (e) => { e.preventDefault(); m.remove(); showSignupModal(); };
    document.getElementById("loginForm").onsubmit = async (e) => {
      e.preventDefault();
      const email = e.target.email.value.trim();
      const password = e.target.password.value;
      try {
        await api("POST", "/api/v1/auth/login", { email, password });
        location.reload();
      } catch (err) {
        const errDiv = document.getElementById("loginErr");
        errDiv.innerHTML = '<div style="background:rgba(239,68,68,0.15);color:#fca5a5;padding:10px 14px;border-radius:8px;border:1px solid rgba(239,68,68,0.3);font-size:10pt;margin-bottom:12px">✕ ' + err.message + '</div>';
      }
    };
  }

  function showSignupModal() {
    const m = document.createElement("div");
    m.id = "memberSignupModal";
    m.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px";
    m.innerHTML = `
      <div style="background:#16161f;border:1px solid var(--border);border-radius:16px;padding:28px;max-width:420px;width:100%;position:relative">
        <h2 style="margin:0 0 4px;font-size:18pt;color:var(--text-primary)">✨ Create account</h2>
        <p style="margin:0 0 18px;color:var(--text-muted);font-size:10pt">100 free renders/month · no credit card.</p>
        <div id="signupErr"></div>
        <div id="signupOk"></div>
        <form id="signupForm" style="display:flex;flex-direction:column;gap:12px">
          <div><label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;margin-bottom:5px">Email</label><input type="email" name="email" required style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit"></div>
          <div><label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;margin-bottom:5px">Display name (optional)</label><input type="text" name="display_name" style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit"></div>
          <div><label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;margin-bottom:5px">Password (min 8 chars)</label><input type="password" name="password" required minlength="8" style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit"></div>
          <button type="submit" style="padding:10px 18px;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border:none;border-radius:7px;cursor:pointer;font-family:inherit;font-weight:500;font-size:11pt;margin-top:6px">Create account</button>
        </form>
        <div style="text-align:center;margin-top:14px;font-size:10pt;color:var(--text-muted)">Have an account? <a href="#" id="showLoginLink" style="color:#60a5fa">Sign in →</a></div>
        <button id="closeSignupModal" style="position:absolute;top:14px;right:14px;background:transparent;border:none;color:var(--text-muted);cursor:pointer;font-size:20pt;line-height:1">&times;</button>
      </div>
    `;
    document.body.appendChild(m);
    document.getElementById("closeSignupModal").onclick = () => m.remove();
    document.getElementById("showLoginLink").onclick = (e) => { e.preventDefault(); m.remove(); showLoginModal(); };
    document.getElementById("signupForm").onsubmit = async (e) => {
      e.preventDefault();
      const email = e.target.email.value.trim();
      const display_name = e.target.display_name.value.trim() || null;
      const password = e.target.password.value;
      try {
        const data = await api("POST", "/api/v1/auth/signup", { email, password, display_name });
        const ok = document.getElementById("signupOk");
        ok.innerHTML = "<div style='background:rgba(34,197,94,0.15);color:#86efac;padding:12px;border-radius:8px;border:1px solid rgba(34,197,94,0.3);font-size:10pt;margin-bottom:12px'>✓ Account created! Save your API key (shown once):<div style='font-family:SF Mono,monospace;background:#0f0f1a;padding:8px;margin-top:6px;border-radius:4px;font-size:10pt;color:#fbbf24;word-break:break-all'>" + data.api_key + "</div></div>";
        try { await navigator.clipboard.writeText(data.api_key); ok.innerHTML += "<div style='margin-top:4px;color:#22c55e;font-size:10pt'>✓ Copied to clipboard!</div>"; } catch {}
        ok.innerHTML += "<div style='margin-top:8px;color:#9aa0b4;font-size:10pt'>Signing you in...</div>";
        setTimeout(() => location.reload(), 3000);
      } catch (err) {
        const errDiv = document.getElementById("signupErr");
        errDiv.innerHTML = '<div style="background:rgba(239,68,68,0.15);color:#fca5a5;padding:10px 14px;border-radius:8px;border:1px solid rgba(239,68,68,0.3);font-size:10pt;margin-bottom:12px">✕ ' + err.message + '</div>';
      }
    };
  }

  // ============== INIT ==============
  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(async () => {
      try { const r = await api("GET", "/api/v1/auth/me"); if (r.ok) _me = r; } catch {}
      renderMemberBar(_me);
      if (_me) {
        renderDropdown();
        const chip = document.getElementById("memberChip");
        chip?.addEventListener("click", e => { e.stopPropagation(); showDropdown(); });
        document.getElementById("logoutBtn")?.addEventListener("click", async () => {
          await api("POST", "/api/v1/auth/logout", {});
          location.reload();
        });
        document.addEventListener("click", () => {
          const menu = document.getElementById("memberDropdown");
          if (menu) menu.style.display = "none";
        });
        await loadJobHistory();
        // Poll every 15s for new completions
        setInterval(pollJobs, 15000);
      }
      document.getElementById("memberSignupBtn")?.addEventListener("click", showSignupModal);
      document.getElementById("memberLoginBtn")?.addEventListener("click", showLoginModal);
    }, 100);
  });
})();
</script>
<script src="/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js" data-cf-settings="9dee3366aadfb249916fac86-|49" defer></script><script type="776d20384fb23acd67a6ba82-text/javascript">
(function() {
  const API = "";  // same origin
  const WS_BASE = (location.protocol === "https:" ? "wss://" : "ws://") + location.host;
  let _me = null;
  let _knownJobIds = new Set();
  let _ws = null;  // active WebSocket for active job (if any)
  let _wsJobId = null;

  async function api(method, url, body) {
    const opts = { method, headers: {}, credentials: "same-origin" };
    if (body) { opts.headers["Content-Type"] = "application/json"; opts.body = JSON.stringify(body); }
    const r = await fetch(API + url, opts);
    const text = await r.text();
    let d; try { d = JSON.parse(text); } catch { d = { ok:false, error: text }; }
    if (!r.ok) throw new Error(d.detail || d.error || r.statusText);
    return d;
  }
  function esc(s) { return String(s ?? "").replace(/[<>&"']/g, c => ({"<":"&lt;",">":"&gt;","&":"&amp;",'"':"&quot;","'":"&#39;"}[c])); }
  function fmtAgo(epoch) { if (!epoch) return "—"; const dt = Date.now()/1000 - epoch; if (dt<60) return Math.floor(dt)+"s ago"; if (dt<3600) return Math.floor(dt/60)+"m ago"; if (dt<86400) return Math.floor(dt/3600)+"h ago"; return Math.floor(dt/86400)+"d ago"; }
  function fmtSize(b) { if (!b) return "—"; const u = ["B","KB","MB","GB"]; let i=0, v=b; while (v>=1024 && i<u.length-1) { v/=1024; i++; } return v.toFixed(1)+" "+u[i]; }
  function fmtSec(s) { if (s==null || s===0) return "—"; if (s<60) return s.toFixed(1)+"s"; if (s<3600) return Math.floor(s/60)+"m"; return Math.floor(s/3600)+"h"; }
  function tierLabel(tier) {
    if (tier === "pro") return { name: "Pro", color: "#a855f7", badge: "⚡" };
    if (tier === "enterprise") return { name: "Enterprise", color: "#22d3ee", badge: "👑" };
    return { name: "Free", color: "#6b7280", badge: "🆓" };
  }

  // ============== Toast notification ==============
  function ensureToastContainer() {
    let c = document.getElementById("v3ToastContainer");
    if (!c) {
      c = document.createElement("div");
      c.id = "v3ToastContainer";
      c.style.cssText = "position:fixed;top:80px;right:24px;z-index:99999;display:flex;flex-direction:column;gap:10px;max-width:360px;pointer-events:none";
      document.body.appendChild(c);
    }
    return c;
  }
  function showToast(title, message, link, color = "#22c55e") {
    const c = ensureToastContainer();
    const t = document.createElement("div");
    t.style.cssText = `background:#16161f;border:1px solid ${color};border-left:4px solid ${color};border-radius:8px;padding:14px 16px;box-shadow:0 8px 24px rgba(0,0,0,0.4);font-family:inherit;animation:slideIn 0.3s ease;pointer-events:auto;display:flex;align-items:flex-start;gap:10px`;
    const icon = color === "#22c55e" ? "✓" : color === "#ef4444" ? "✕" : color === "#f59e0b" ? "⏵" : color === "#a855f7" ? "⚡" : "ℹ";
    t.innerHTML = `
      <div style="color:${color};font-size:18pt;line-height:1">${icon}</div>
      <div style="flex:1;min-width:0">
        <div style="font-weight:600;color:var(--text-primary);margin-bottom:4px">${esc(title)}</div>
        <div style="color:var(--text-secondary);font-size:10pt;line-height:1.4">${esc(message)}</div>
        ${link ? `<a href="${esc(link)}" style="display:inline-block;margin-top:6px;color:#60a5fa;text-decoration:none;font-size:10pt">View details →</a>` : ""}
      </div>
      <button onclick="this.parentNode.remove()" style="background:transparent;border:none;color:var(--text-muted);cursor:pointer;font-size:14pt;line-height:1;padding:0;margin-left:4px">×</button>
    `;
    c.appendChild(t);
    setTimeout(() => { if (t.parentNode) t.remove(); }, 12000);
  }
  if (!document.getElementById("v3ToastStyle")) {
    const s = document.createElement("style");
    s.id = "v3ToastStyle";
    s.textContent = "@keyframes slideIn { from { transform: translateX(20px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }";
    document.head.appendChild(s);
  }

  // ============== Member bar (header) ==============
  function renderMemberBar(me) {
    const authBtn = document.getElementById("authBtn");
    if (!authBtn) return;
    const bar = document.createElement("div");
    bar.id = "memberBar";
    bar.style.cssText = "display:flex;align-items:center;gap:8px;margin-left:8px;padding:0 4px;border-left:1px solid var(--border)";
    if (!me) {
      bar.innerHTML = `
        <button class="header-btn" id="memberSignupBtn" style="background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border:none;font-weight:600">✨ Sign up</button>
        <button class="header-btn" id="memberLoginBtn">🔑 Sign in</button>
      `;
    } else {
      const u = me.user;
      const pct = Math.min(100, Math.round(100 * u.monthly_used / Math.max(u.monthly_quota, 1)));
      const pctColor = pct >= 90 ? "#ef4444" : pct >= 70 ? "#f59e0b" : "#22c55e";
      const initial = (u.display_name || u.email || u.user_id).slice(0, 2).toUpperCase();
      const tier = tierLabel(u.tier || "free");
      const tierBadge = `<span style="display:inline-block;padding:1px 6px;background:${tier.color}22;color:${tier.color};border-radius:3px;font-size:8pt;font-weight:600;margin-left:4px">${tier.badge} ${tier.name}</span>`;
      bar.innerHTML = `
        <div id="memberChip" style="position:relative;display:flex;align-items:center;gap:10px;padding:6px 14px 6px 6px;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:18px;cursor:pointer;color:#86efac;font-size:10pt;min-width:200px">
          <div style="width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#22c55e,#10b981);display:flex;align-items:center;justify-content:center;font-size:12px;color:#0a0c14;font-weight:600;flex-shrink:0">${esc(initial)}</div>
          <div style="display:flex;flex-direction:column;line-height:1.2;flex:1;min-width:0;overflow:hidden">
            <div style="display:flex;align-items:center"><strong style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(u.display_name || u.email)}</strong>${tierBadge}</div>
            <div style="display:flex;align-items:center;gap:6px;margin-top:3px">
              <div style="flex:1;height:4px;background:rgba(255,255,255,0.08);border-radius:2px;overflow:hidden;max-width:120px">
                <div style="width:${pct}%;height:100%;background:${pctColor};border-radius:2px;transition:width 0.5s"></div>
              </div>
              <span style="color:#9aa0b4;font-size:8pt;font-variant-numeric:tabular-nums">${u.monthly_used}/${u.monthly_quota}</span>
            </div>
          </div>
          <span style="color:#9aa0b4;font-size:8pt">▾</span>
        </div>
      `;
    }
    authBtn.style.display = "none";
    authBtn.parentNode.insertBefore(bar, authBtn);
  }

  function renderDropdown() {
    const menu = document.createElement("div");
    menu.id = "memberDropdown";
    menu.style.cssText = "position:absolute;top:calc(100% + 6px);right:0;background:#16161f;border:1px solid var(--border);border-radius:10px;padding:6px;min-width:240px;box-shadow:0 10px 30px rgba(0,0,0,0.5);z-index:1000;display:none";
    menu.innerHTML = `
      <a href="/api/app" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt" onmouseover="this.style.background='#28283a'" onmouseout="this.style.background='transparent'">👤 My Dashboard</a>
      <a href="/api/app/jobs" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt" onmouseover="this.style.background='#28283a'" onmouseout="this.style.background='transparent'">📜 My Jobs</a>
      <a href="/api/app/submit" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;font-weight:600">+ Submit Job</a>
      <a href="/api/app/profile" style="display:flex;align-items:center;gap:8px;padding:8px 12px;color:#e8e8f0;text-decoration:none;border-radius:6px;font-size:11pt" onmouseover="this.style.background='#28283a'" onmouseout="this.style.background='transparent'">⚙️ Profile</a>
      <hr style="border:none;border-top:1px solid var(--border);margin:4px 0">
      <button id="logoutBtn" style="width:100%;text-align:left;background:transparent;border:none;color:#9aa0b4;padding:8px 12px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11pt" onmouseover="this.style.background='#28283a';this.style.color='#ef4444'" onmouseout="this.style.background='transparent';this.style.color='#9aa0b4'">↪ Sign out</button>
    `;
    document.body.appendChild(menu);
  }

  function showDropdown() {
    const menu = document.getElementById("memberDropdown");
    const chip = document.getElementById("memberChip");
    if (!menu || !chip) return;
    const r = chip.getBoundingClientRect();
    menu.style.top = (r.bottom + 4) + "px";
    menu.style.right = (window.innerWidth - r.right) + "px";
    menu.style.display = "block";
  }

  // ============== Job history + WebSocket integration ==============
  async function loadJobHistory() {
    const d = await api("GET", "/api/v1/users/me/jobs?limit=20");
    const jobs = d.jobs || [];
    if (!jobs.length) return;
    const nav = document.querySelector("nav.tabs");
    if (!nav) return;
    document.getElementById("myJobsPanel")?.remove();

    // Track known jobs (for toast on completion via WS or polling)
    if (_knownJobIds.size === 0) {
      jobs.forEach(j => _knownJobIds.add(j.job_id));
    } else {
      // Check for newly completed jobs (via polling)
      for (const j of jobs) {
        if (!_knownJobIds.has(j.job_id)) {
          notifyJobEvent(j);
          _knownJobIds.add(j.job_id);
        }
      }
    }

    const panel = document.createElement("section");
    panel.id = "myJobsPanel";
    panel.style.cssText = "margin:0 24px 24px;background:#16161f;border:1px solid var(--border);border-radius:10px;padding:18px";
    const tier = _me ? tierLabel(_me.user.tier || "free") : tierLabel("free");
    panel.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
        <h3 style="margin:0;font-size:13pt;color:var(--text-primary)">📋 ประวัติงานของฉัน <span style="display:inline-block;padding:2px 8px;background:${tier.color}22;color:${tier.color};border-radius:3px;font-size:9pt;font-weight:600;margin-left:6px">${tier.badge} ${tier.name} tier</span></h3>
        <div>
          <a href="/api/app/submit" style="display:inline-flex;align-items:center;gap:4px;padding:6px 14px;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border-radius:6px;text-decoration:none;font-weight:500;font-size:10pt;margin-right:8px">+ Submit Job</a>
          <a href="/api/app/jobs" style="display:inline-flex;align-items:center;gap:4px;padding:6px 12px;background:transparent;border:1px solid var(--border);color:var(--text-secondary);border-radius:6px;text-decoration:none;font-size:10pt">View all →</a>
        </div>
      </div>
      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:10pt">
          <thead>
            <tr style="border-bottom:1px solid var(--border);color:var(--text-muted);text-align:left;font-size:9pt;text-transform:uppercase;letter-spacing:0.04em">
              <th style="padding:8px 10px">Job ID</th>
              <th style="padding:8px 10px">TC</th>
              <th style="padding:8px 10px">Status</th>
              <th style="padding:8px 10px">Worker</th>
              <th style="padding:8px 10px">Size</th>
              <th style="padding:8px 10px">Duration</th>
              <th style="padding:8px 10px">Created</th>
              <th style="padding:8px 10px">Actions</th>
            </tr>
          </thead>
          <tbody>
            ${jobs.slice(0, 10).map(j => {
              const tcColor = {tc01:"#4CAF50",tc02:"#A855F7",tc03:"#3B82F6",tc04:"#06B6D4",tc05:"#F59E0B",tc06:"#EC4899"}[j.tc] || "#6e6e82";
              const statusColor = {succeeded:"#10B981",running:"#3B82F6",queued:"#F59E0B",failed:"#EF4444",paused:"#A855F7",SUCCEEDED:"#10B981",FAILED:"#EF4444",INVALID_INPUT:"#A855F7",deleted:"#6e6e82"}[j.status] || "#9aa0b8";
              const duration = (j.started_at && j.finished_at) ? (j.finished_at - j.started_at).toFixed(1) + "s" : (j.status === "running" ? "running..." : "—");
              const actions = `
                <button data-jid="${esc(j.job_id)}" data-action="cancel" class="jobActionBtn" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.3);padding:3px 8px;border-radius:4px;font-size:9pt;cursor:pointer;font-family:inherit" title="Cancel running job">⏹ Cancel</button>
                <button data-jid="${esc(j.job_id)}" data-action="delete" class="jobActionBtn" style="background:rgba(107,114,128,0.15);color:#9aa0b4;border:1px solid rgba(107,114,128,0.3);padding:3px 8px;border-radius:4px;font-size:9pt;cursor:pointer;font-family:inherit;margin-left:4px" title="Delete job">🗑 Delete</button>
              `;
              return `<tr style="border-bottom:1px solid var(--border)">
                <td style="padding:8px 10px;font-family:'SF Mono',Consolas,monospace;font-size:9pt"><a href="/api/app/job/${encodeURIComponent(j.job_id)}" style="color:#60a5fa;text-decoration:none">${esc(j.job_id?.slice(-12))}</a></td>
                <td style="padding:8px 10px"><span style="display:inline-block;padding:2px 8px;background:${tcColor}22;color:${tcColor};border-radius:3px;font-size:9pt;font-weight:600">${esc((j.tc||"").toUpperCase())}</span></td>
                <td style="padding:8px 10px"><span style="color:${statusColor};font-weight:500">${esc(j.status)}</span></td>
                <td style="padding:8px 10px;color:var(--text-muted);font-family:'SF Mono',Consolas,monospace;font-size:9pt">${esc(j.worker_id || "—")}</td>
                <td style="padding:8px 10px;color:var(--text-secondary)">${j.output_size ? fmtSize(j.output_size) : "—"}</td>
                <td style="padding:8px 10px;color:var(--text-secondary);font-variant-numeric:tabular-nums">${duration}</td>
                <td style="padding:8px 10px;color:var(--text-muted)">${fmtAgo(j.created_at)}</td>
                <td style="padding:8px 10px">${actions}</td>
              </tr>`;
            }).join("")}
          </tbody>
        </table>
      </div>
    `;
    nav.parentNode.insertBefore(panel, nav.nextSibling);
    panel.querySelectorAll(".jobActionBtn").forEach(btn => {
      btn.addEventListener("click", async () => {
        const jid = btn.dataset.jid;
        const action = btn.dataset.action;
        if (action === "cancel") {
          if (!confirm(`Cancel job ${jid.slice(-12)}?`)) return;
          try {
            await api("POST", `/api/v1/jobs/${encodeURIComponent(jid)}/cancel`, {});
            showToast("Job cancellation requested", `${jid.slice(-12)} will be cancelled`, null, "#f59e0b");
            setTimeout(loadJobHistory, 1500);
          } catch (e) { alert("Cancel failed: " + e.message); }
        } else if (action === "delete") {
          if (!confirm(`Delete job ${jid.slice(-12)}?`)) return;
          try {
            await api("DELETE", `/api/v1/jobs/${encodeURIComponent(jid)}`);
            showToast("Job deleted", `${jid.slice(-12)} was removed from history`, null, "#9aa0b4");
            setTimeout(loadJobHistory, 500);
          } catch (e) { alert("Delete failed: " + e.message); }
        }
      });
    });
  }

  function notifyJobEvent(j) {
    if (!j) return;
    const color = j.status === "succeeded" ? "#22c55e"
                : j.status === "failed" ? "#ef4444"
                : j.status === "running" ? "#3B82F6"
                : j.status === "queued" ? "#f59e0b"
                : "#60a5fa";
    const tier = j.tc?.toUpperCase() || "?";
    const title = j.status === "succeeded" ? "Job completed ✓" : j.status === "failed" ? "Job failed" : `Job status: ${j.status}`;
    const msg = `${tier} · ${j.output_size ? fmtSize(j.output_size) : "—"} · ${fmtAgo(j.created_at)}`;
    showToast(title, msg, `/api/app/job/${j.job_id}`, color);
  }

  // ============== WebSocket live updates (FIX 2026-08-19) ==============
  function connectWS(jobId) {
    if (_ws && _wsJobId === jobId) return;  // already connected
    disconnectWS();
    try {
      _ws = new WebSocket(WS_BASE + "/ws/jobs/" + jobId);
      _wsJobId = jobId;
      _ws.onmessage = (ev) => {
        try {
          const msg = JSON.parse(ev.data);
          if (msg.type === "hello") {
            // Initial state
            return;
          }
          if (msg.type === "progress" || msg.type === "done") {
            // Real-time update!
            const job = {
              job_id: jobId,
              tc: msg.tc || (window._currentJobTc || "?"),
              status: msg.status,
              output_size: msg.output_size,
              created_at: msg.started_at || Date.now()/1000,
              output_files: msg.output_files || [],
              current_step: msg.current_step,
            };
            notifyJobEvent(job);
            // Update history if shown
            if (document.getElementById("myJobsPanel")) {
              loadJobHistory();
            }
            if (msg.status === "succeeded" || msg.status === "failed") {
              // Job complete — show final toast
              showToast(
                msg.status === "succeeded" ? "Job complete ✓" : "Job failed ✕",
                `${(msg.tc || "?").toUpperCase()} · ${msg.output_size ? fmtSize(msg.output_size) : "—"} · ${fmtSec(msg.duration_sec || 0)}`,
                `/api/app/job/${jobId}`,
                msg.status === "succeeded" ? "#22c55e" : "#ef4444"
              );
            }
          }
        } catch (e) { console.error("WS msg", e); }
      };
      _ws.onclose = (ev) => {
        _ws = null;
        if (ev.code === 1000 || ev.code === 1001) return;  // normal close
        // Reconnect after 3s
        setTimeout(() => { if (_wsJobId === jobId) connectWS(jobId); }, 3000);
      };
      _ws.onerror = (ev) => { console.warn("WS error", ev); };
    } catch (e) {
      console.error("WS connect error", e);
    }
  }

  function disconnectWS() {
    if (_ws) { try { _ws.close(1000, "user nav"); } catch {} _ws = null; _wsJobId = null; }
  }

  // ============== INIT ==============
  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(async () => {
      try { const r = await api("GET", "/api/v1/auth/me"); if (r.ok) _me = r; } catch {}
      renderMemberBar(_me);
      if (_me) {
        renderDropdown();
        const chip = document.getElementById("memberChip");
        chip?.addEventListener("click", e => { e.stopPropagation(); showDropdown(); });
        document.getElementById("logoutBtn")?.addEventListener("click", async () => {
          await api("POST", "/api/v1/auth/logout", {});
          location.reload();
        });
        document.addEventListener("click", () => {
          const menu = document.getElementById("memberDropdown");
          if (menu) menu.style.display = "none";
        });
        await loadJobHistory();
        // Poll every 30s for new completions (fallback)
        setInterval(pollJobs, 30000);
        // If we're on a job detail page, connect to its WebSocket
        if (location.pathname.match(/^/v3api\/app\/job\//)) {
          const jid = location.pathname.split("/").pop();
          window._currentJobTc = "?";  // could fetch from API
          connectWS(jid);
        }
      }
      document.getElementById("memberSignupBtn")?.addEventListener("click", showSignupModal);
      document.getElementById("memberLoginBtn")?.addEventListener("click", showLoginModal);
    }, 100);
  });

  async function pollJobs() {
    if (!_me) return;
    try {
      const d = await api("GET", "/api/v1/users/me/jobs?limit=20");
      for (const j of d.jobs || []) {
        if (!_knownJobIds.has(j.job_id)) {
          notifyJobEvent(j);
          _knownJobIds.add(j.job_id);
        }
      }
    } catch (e) { console.error("pollJobs", e); }
  }

  function showLoginModal() {
    const m = document.createElement("div");
    m.id = "memberLoginModal";
    m.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px";
    m.innerHTML = `<div style="background:#16161f;border:1px solid var(--border);border-radius:16px;padding:28px;max-width:420px;width:100%;position:relative"><h2 style="margin:0 0 4px;font-size:18pt;color:var(--text-primary)">🔑 Sign in</h2><p style="margin:0 0 18px;color:var(--text-muted);font-size:10pt">Sign in to your V3 Studio account.</p><div id="loginErr"></div><form id="loginForm" style="display:flex;flex-direction:column;gap:12px"><div><label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;margin-bottom:5px">Email</label><input type="email" name="email" required style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit"></div><div><label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;margin-bottom:5px">Password</label><input type="password" name="password" required style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit"></div><button type="submit" style="padding:10px 18px;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border:none;border-radius:7px;cursor:pointer;font-family:inherit;font-weight:500;font-size:11pt;margin-top:6px">Sign in</button></form><div style="text-align:center;margin-top:14px;font-size:10pt;color:var(--text-muted)">No account? <a href="#" id="showSignupLink" style="color:#60a5fa">Create one in 30s →</a></div><button id="closeLoginModal" style="position:absolute;top:14px;right:14px;background:transparent;border:none;color:var(--text-muted);cursor:pointer;font-size:20pt;line-height:1">&times;</button></div>`;
    document.body.appendChild(m);
    document.getElementById("closeLoginModal").onclick = () => m.remove();
    document.getElementById("showSignupLink").onclick = (e) => { e.preventDefault(); m.remove(); showSignupModal(); };
    document.getElementById("loginForm").onsubmit = async (e) => {
      e.preventDefault();
      try { await api("POST", "/api/v1/auth/login", { email: e.target.email.value.trim(), password: e.target.password.value }); location.reload(); }
      catch (err) { document.getElementById("loginErr").innerHTML = '<div style="background:rgba(239,68,68,0.15);color:#fca5a5;padding:10px 14px;border-radius:8px;border:1px solid rgba(239,68,68,0.3);font-size:10pt;margin-bottom:12px">✕ ' + err.message + '</div>'; }
    };
  }

  function showSignupModal() {
    const m = document.createElement("div");
    m.id = "memberSignupModal";
    m.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.7);backdrop-filter:blur(8px);z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px";
    m.innerHTML = `<div style="background:#16161f;border:1px solid var(--border);border-radius:16px;padding:28px;max-width:420px;width:100%;position:relative"><h2 style="margin:0 0 4px;font-size:18pt;color:var(--text-primary)">✨ Create account</h2><p style="margin:0 0 18px;color:var(--text-muted);font-size:10pt">100 free renders/month · upgrade to Pro for priority.</p><div id="signupErr"></div><div id="signupOk"></div><form id="signupForm" style="display:flex;flex-direction:column;gap:12px"><div><label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;margin-bottom:5px">Email</label><input type="email" name="email" required style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit"></div><div><label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;margin-bottom:5px">Display name (optional)</label><input type="text" name="display_name" style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit"></div><div><label style="display:block;font-size:9pt;color:var(--text-muted);text-transform:uppercase;margin-bottom:5px">Password (min 8 chars)</label><input type="password" name="password" required minlength="8" style="width:100%;padding:10px 12px;background:#0f0f1a;border:1px solid var(--border);border-radius:7px;color:var(--text-primary);font-size:11pt;font-family:inherit"></div><button type="submit" style="padding:10px 18px;background:linear-gradient(135deg,#22c55e,#10b981);color:#0a0c14;border:none;border-radius:7px;cursor:pointer;font-family:inherit;font-weight:500;font-size:11pt;margin-top:6px">Create account</button></form><div style="text-align:center;margin-top:14px;font-size:10pt;color:var(--text-muted)">Have an account? <a href="#" id="showLoginLink" style="color:#60a5fa">Sign in →</a></div><button id="closeSignupModal" style="position:absolute;top:14px;right:14px;background:transparent;border:none;color:var(--text-muted);cursor:pointer;font-size:20pt;line-height:1">&times;</button></div>`;
    document.body.appendChild(m);
    document.getElementById("closeSignupModal").onclick = () => m.remove();
    document.getElementById("showLoginLink").onclick = (e) => { e.preventDefault(); m.remove(); showLoginModal(); };
    document.getElementById("signupForm").onsubmit = async (e) => {
      e.preventDefault();
      try {
        const data = await api("POST", "/api/v1/auth/signup", { email: e.target.email.value.trim(), password: e.target.password.value, display_name: e.target.display_name.value.trim() || null });
        const ok = document.getElementById("signupOk");
        ok.innerHTML = "<div style='background:rgba(34,197,94,0.15);color:#86efac;padding:12px;border-radius:8px;border:1px solid rgba(34,197,94,0.3);font-size:10pt;margin-bottom:12px'>✓ Account created! Save your API key (shown once):<div style='font-family:SF Mono,monospace;background:#0f0f1a;padding:8px;margin-top:6px;border-radius:4px;font-size:10pt;color:#fbbf24;word-break:break-all'>" + data.api_key + "</div></div>";
        try { await navigator.clipboard.writeText(data.api_key); ok.innerHTML += "<div style='margin-top:4px;color:#22c55e;font-size:10pt'>✓ Copied to clipboard!</div>"; } catch {}
        ok.innerHTML += "<div style='margin-top:8px;color:#9aa0b4;font-size:10pt'>Signing you in...</div>";
        setTimeout(() => location.reload(), 3000);
      } catch (err) {
        document.getElementById("signupErr").innerHTML = '<div style="background:rgba(239,68,68,0.15);color:#fca5a5;padding:10px 14px;border-radius:8px;border:1px solid rgba(239,68,68,0.3);font-size:10pt;margin-bottom:12px">✕ ' + err.message + '</div>';
      }
    };
  }
})();
</script>
<script src="/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js" data-cf-settings="776d20384fb23acd67a6ba82-|49" defer></script></body>
</html>
